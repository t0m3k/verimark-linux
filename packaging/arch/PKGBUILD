_validate_patch_series() {
  local series_file=$1
  local patch_directory=$2
  local patch_name patch_path count=0
  local -a patch_names=()
  declare -A seen=()

  if [[ ! -f $series_file || -L $series_file ]]; then
    error "libfprint patch series must be a regular non-symlink file"
    return 1
  fi

  while IFS= read -r patch_name || [[ -n $patch_name ]]; do
    if [[ -z $patch_name ]]; then
      error "blank libfprint patch-series entry"
      return 1
    fi
    if [[ ! $patch_name =~ ^[0-9]{4}-[a-z0-9][a-z0-9-]*\.patch$ ]]; then
      error "invalid libfprint patch-series entry: $patch_name"
      return 1
    fi
    if [[ -n ${seen[$patch_name]+present} ]]; then
      error "duplicate libfprint patch-series entry: $patch_name"
      return 1
    fi
    seen["$patch_name"]=1
    patch_path="$patch_directory/$patch_name"
    if [[ ! -f $patch_path || -L $patch_path ]]; then
      error "libfprint patch entry must be a regular non-symlink file: $patch_name"
      return 1
    fi
    patch_names+=("$patch_name")
    count=$((count + 1))
  done < "$series_file"

  if (( count == 0 )); then
    error "libfprint patch series is empty"
    return 1
  fi

  for patch_name in "${patch_names[@]}"; do
    patch_path="$patch_directory/$patch_name"
    if ! grep -Eq '^From [0-9a-f]{40} Mon Sep 17 00:00:00 2001$' "$patch_path"; then
      error "libfprint patch entry is missing a mail header: $patch_name"
      return 1
    fi
    if ! grep -Eq '^From: .+ <[^>]+>$' "$patch_path"; then
      error "libfprint patch entry is missing mail authorship: $patch_name"
      return 1
    fi
  done
}

_source_filename() {
  local entry=$1

  if [[ $entry == *::* ]]; then
    printf '%s\n' "${entry%%::*}"
  else
    printf '%s\n' "${entry##*/}"
  fi
}

_stage_patch_series() {
  local source_directory=$1
  local patch_directory=$2
  local source_index source_name source_path destination expected actual

  if [[ -e $patch_directory || -L $patch_directory ]]; then
    error "private libfprint patch stage already exists"
    return 1
  fi
  install -d -m 0755 "$patch_directory" || return 1

  for ((source_index = 1; source_index < ${#source[@]}; source_index++)); do
    source_name=$(_source_filename "${source[source_index]}") || return 1
    if [[ $source_name != series \
          && ! $source_name =~ ^[0-9]{4}-[a-z0-9][a-z0-9-]*\.patch$ ]]; then
      error "invalid configured libfprint patch source: $source_name"
      return 1
    fi
    expected=${b2sums[source_index]}
    if [[ ! $expected =~ ^[0-9a-f]{128}$ ]]; then
      error "missing configured checksum for libfprint patch source: $source_name"
      return 1
    fi
    source_path="$source_directory/$source_name"
    destination="$patch_directory/$source_name"
    if [[ ! -f $source_path ]]; then
      error "missing makepkg-staged libfprint patch source: $source_name"
      return 1
    fi

    # makepkg deliberately stages local sources as symlinks. Dereference each
    # checksum-identified input once into a private regular-file directory;
    # validation and git-am never follow a source-stage symlink afterwards.
    install -m 0644 -- "$source_path" "$destination" || return 1
    if [[ ! -f $destination || -L $destination ]]; then
      error "private libfprint patch source is not a regular file: $source_name"
      return 1
    fi
    actual=$(b2sum -- "$destination") || return 1
    actual=${actual%% *}
    if [[ $actual != "$expected" ]]; then
      error "libfprint patch source checksum mismatch: $source_name"
      return 1
    fi
  done

  _validate_patch_series "$patch_directory/series" "$patch_directory"
}

prepare() {
  local patch_directory="${srcdir}/.verimark-patches"

  _stage_patch_series "$srcdir" "$patch_directory" || return 1
  cd libfprint
  if [[ $(git rev-parse HEAD) != "$_commit" ]]; then
    error "resolved source does not match pinned commit $_commit"
    return 1
  fi

  while IFS= read -r patch_name || [[ -n $patch_name ]]; do
    GIT_COMMITTER_NAME="VeriMark Package Materializer" \
      GIT_COMMITTER_EMAIL="materializer@invalid" \
      git am --keep-cr "${patch_directory}/${patch_name}"
  done < "${patch_directory}/series"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson libfprint build "${meson_options[@]}"
  meson compile -C build

  arch-meson libfprint/libfprint/drivers/verimark build-verimark-tests --werror
  meson compile -C build-verimark-tests
}

check() {
  meson test -C build --print-errorlogs
  meson test -C build-verimark-tests --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

