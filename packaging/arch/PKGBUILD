pkgname=libfprint-verimark
pkgver=1.94.10.r1.g66591aa
pkgrel=1
pkgdesc="Library for fingerprint readers with experimental Kensington VeriMark support"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
options=(!debug)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
  gnutls
  nettle
  gmp
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
_commit=66591aae03856bcefa7d7b4c0f08ea630f64b623
source=(
  "libfprint::git+https://gitlab.freedesktop.org/s-celles/libfprint.git#commit=$_commit"
  fix-generated-data-checks.patch
)
b2sums=(
  SKIP
  db41b94eb90e369e89eb172312ecb1ab8f23943cfc0841a8023ee7960f386ca851304d42f652bce83923c241ff65ea199eab4f274187af7cfa1f96543cd3dfd1
)

prepare() {
  cd libfprint
  if [[ $(git rev-parse HEAD) != "$_commit" ]]; then
    error "resolved source does not match pinned commit $_commit"
    return 1
  fi
  patch -Np1 -i "$srcdir/fix-generated-data-checks.patch"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson libfprint build "${meson_options[@]}"
  meson compile -C build

  arch-meson libfprint/libfprint/drivers/verimark build-verimark-tests --werror
  meson compile -C build-verimark-tests
}

check() {
  meson test -C build --print-errorlogs
  meson test -C build-verimark-tests --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

