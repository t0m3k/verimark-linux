pkgname=libfprint-verimark
pkgver=1.94.10.r1.g66591aa
pkgrel=1
pkgdesc="Library for fingerprint readers with experimental Kensington VeriMark support"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
options=(!debug)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
  gnutls
  nettle
  gmp
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
_commit=66591aae03856bcefa7d7b4c0f08ea630f64b623
source=(
  "libfprint::git+https://gitlab.freedesktop.org/s-celles/libfprint.git#commit=$_commit"
  "series::../../patches/libfprint/series"
  "0001-build-make-generated-data-checks-deterministic.patch::../../patches/libfprint/0001-build-make-generated-data-checks-deterministic.patch"
)
b2sums=(
  SKIP
  e2ce873c8b4790b6064ab6aeeee8a3610cfa674f0f24da0a32eeaecc4d1d56892d64d2538ff06a253624189322f783296bce287d822aab4ea257e53d967c6c0b
  50836dfff9c20118963b1d565f63ebf2b297bc775fb903be14fe851427ea9d091c87f3b4b7938fe7419876dd1eab5058e5836792bd3f3631720f30adfd97ea72
)

prepare() {
  cd libfprint
  if [[ $(git rev-parse HEAD) != "$_commit" ]]; then
    error "resolved source does not match pinned commit $_commit"
    return 1
  fi
  while IFS= read -r patch_name; do
    if [[ ! $patch_name =~ ^[0-9]{4}-[a-z0-9][a-z0-9-]*\.patch$ ]]; then
      error "invalid libfprint patch-series entry: $patch_name"
      return 1
    fi
    git apply --index "${srcdir}/${patch_name}"
  done < "${srcdir}/series"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson libfprint build "${meson_options[@]}"
  meson compile -C build

  arch-meson libfprint/libfprint/drivers/verimark build-verimark-tests --werror
  meson compile -C build-verimark-tests
}

check() {
  meson test -C build --print-errorlogs
  meson test -C build-verimark-tests --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

