From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomasz Tracz <t@t90.dev>
Date: Mon, 17 Aug 2026 20:17:13 +0100
Subject: [PATCH] build: make generated-data checks deterministic

---
 data/autosuspend.hwdb             | 5 ++++-
 libfprint/fprint-list-udev-hwdb.c | 1 -
 tests/meson.build                 | 2 +-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/data/autosuspend.hwdb b/data/autosuspend.hwdb
index fe68271..84a6e16 100644
--- a/data/autosuspend.hwdb
+++ b/data/autosuspend.hwdb
@@ -323,6 +323,10 @@ usb:v05BAp000A*
 usb:v061Ap0110*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
+# Supported by libfprint driver verimark
+usb:v047Dp00F2*
+ ID_AUTOSUSPEND=1
+ ID_PERSIST=0
 
 # Supported by libfprint driver vfs0050
 usb:v138Ap0050*
@@ -356,7 +360,6 @@ usb:v138Ap0091*
 
 # Known unsupported devices
 usb:v0A5Cp5802*
-usb:v047Dp00F2*
 usb:v047Dp8054*
 usb:v047Dp8055*
 usb:v04E8p730B*
diff --git a/libfprint/fprint-list-udev-hwdb.c b/libfprint/fprint-list-udev-hwdb.c
index 6e2adb0..e385cc9 100644
--- a/libfprint/fprint-list-udev-hwdb.c
+++ b/libfprint/fprint-list-udev-hwdb.c
@@ -30,7 +30,6 @@ static const FpIdEntry allowlist_id_table[] = {
    *   gio cat https://gitlab.freedesktop.org/libfprint/wiki/-/wikis/Unsupported-Devices.md | sed -n 's!|.*\([0-9a-fA-F]\{4\}\):\([0-9a-fA-F]\{4\}\).*|.*!  { .vid = 0x\1, .pid = 0x\2 },!p'
    */
   { .vid = 0x0a5c, .pid = 0x5802 },
-  { .vid = 0x047d, .pid = 0x00f2 },
   { .vid = 0x047d, .pid = 0x8054 },
   { .vid = 0x047d, .pid = 0x8055 },
   { .vid = 0x04e8, .pid = 0x730b },
diff --git a/tests/meson.build b/tests/meson.build
index 07c924b..63ba00b 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -335,7 +335,7 @@ appstreamcli = find_program('appstreamcli', required: false)
 if appstreamcli.found()
     test('metainfo-validate',
         appstreamcli,
-        args: ['validate', metainfo_generator],
+        args: ['validate', '--no-net', metainfo_generator],
         depends: metainfo_generator,
         suite: ['data', 'no-valgrind'],
     )
