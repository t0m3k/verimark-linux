+# meson.build — libfprint driver for Kensington VeriMark DT (047d:00f2)
+#
+# Target: upstream integration as `libfprint/drivers/verimark/`. The
+# convention in libfprint is to drop this file in the driver subdirectory
+# and include it from `libfprint/libfprint/drivers/meson.build` via
+# `subdir('verimark')`.
+#
+# Variables expected by libfprint (see drivers/goodixmoc/meson.build):
+#   - drivers_sources  : aggregated list of driver sources
+#   - drivers_dep      : common dependencies (glib, gusb, etc.)
+#
+# For standalone build (protocol C tests only):
+#   meson setup build --werror
+#   meson test -C build
+
+project('libfprint-verimark', 'c',
+        version: '0.1.0',
+        default_options: ['c_std=c11', 'warning_level=2'])
+
+# --- Sources ----------------------------------------------------------------
+
+verimark_sources = files(
+  'verimark.c',
+  'proto.c',
+  'transport.c',
+  'crypto.c',
+  'tls.c',
+  'pairing.c',
+  'session.c',
+  'handshake.c',
+  'storage.c',
+  'capture.c',
+  'match.c',
+  'enroll.c',
+)
+
+verimark_headers = files(
+  'verimark.h',
+  'proto.h',
+  'transport.h',
+  'crypto.h',
+  'tls.h',
+  'pairing.h',
+  'session.h',
+  'handshake.h',
+  'storage.h',
+  'capture.h',
+  'match.h',
+  'enroll.h',
+)
+
+# Phase 7.1 — crypto primitives (TLS 1.2 PRF + AES-GCM + ECDH + ECDSA via GnuTLS)
+# nettle is required to compute k·G on secp256r1 (GnuTLS's privkey_import_ecc_raw
+# refuses NULL x/y, so we synthesize the pubkey from the scalar with nettle).
+# gmp is a transitive dep of nettle for arbitrary-precision integers.
+gnutls_dep  = dependency('gnutls')
+nettle_dep  = dependency('nettle')
+hogweed_dep = dependency('hogweed')   # nettle ECC sub-lib (ecc_point_mul_g)
+gmp_dep     = dependency('gmp', required: false)
+if not gmp_dep.found()
+  cc = meson.get_compiler('c')
+  gmp_dep = cc.find_library('gmp')
+endif
+
+# --- Standalone build: protocol-layer tests ---------------------------------
+#
+# The skeleton compiles the protocol layer and runs the TDD tests without
+# requiring libfprint installed. The full driver (with libgusb) only builds
+# inside a libfprint fork.
+
+proto_lib = static_library(
+  'proto',
+  files('proto.c'),
+  include_directories: include_directories('.'),
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_proto_exe = executable(
+  'test_proto',
+  files('tests/test_proto.c'),
+  link_with: proto_lib,
+  include_directories: include_directories('.'),
+)
+test('proto', test_proto_exe)
+
+
+crypto_lib = static_library(
+  'crypto',
+  files('crypto.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_crypto_exe = executable(
+  'test_crypto',
+  files('tests/test_crypto.c'),
+  link_with: crypto_lib,
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('crypto', test_crypto_exe)
+
+
+# Phase 7.2 — TLS record + handshake message builders (pure C, no deps)
+tls_lib = static_library(
+  'tls',
+  files('tls.c'),
+  include_directories: include_directories('.'),
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_tls_exe = executable(
+  'test_tls',
+  files('tests/test_tls.c'),
+  link_with: tls_lib,
+  include_directories: include_directories('.'),
+)
+test('tls', test_tls_exe)
+
+
+# Phase 7.3.b — sub1 TLV pairing data loader (pure C, no deps)
+pairing_lib = static_library(
+  'pairing',
+  files('pairing.c'),
+  include_directories: include_directories('.'),
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_pairing_exe = executable(
+  'test_pairing',
+  files('tests/test_pairing.c'),
+  link_with: pairing_lib,
+  include_directories: include_directories('.'),
+)
+test('pairing', test_pairing_exe)
+
+
+# Phase 7.3.c — TLS session AppData wrappers (links crypto + tls)
+session_lib = static_library(
+  'session',
+  files('session.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_session_exe = executable(
+  'test_session',
+  files('tests/test_session.c'),
+  link_with: [session_lib, crypto_lib, tls_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('session', test_session_exe)
+
+
+# Phase 7.3.a — Handshake orchestrator (composes everything)
+handshake_lib = static_library(
+  'handshake',
+  files('handshake.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_handshake_exe = executable(
+  'test_handshake',
+  files('tests/test_handshake.c'),
+  link_with: [handshake_lib, session_lib, tls_lib, crypto_lib, pairing_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('handshake', test_handshake_exe)
+
+
+# Phase 9 step 4.5 — storage layer 2 opcode wrappers (0x9e/0x9f/0xa0)
+storage_lib = static_library(
+  'storage',
+  files('storage.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_storage_exe = executable(
+  'test_storage',
+  files('tests/test_storage.c'),
+  link_with: [storage_lib, session_lib, tls_lib, crypto_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('storage', test_storage_exe)
+
+
+# Phase 9 step 4.5 — capture-pipeline opcode wrappers (0x39/0x80/0x81/0x82)
+capture_lib = static_library(
+  'capture',
+  files('capture.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_capture_exe = executable(
+  'test_capture',
+  files('tests/test_capture.c'),
+  link_with: [capture_lib, session_lib, tls_lib, crypto_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('capture', test_capture_exe)
+
+
+# Phase 9 step 4.5 — Match-on-Chip wrapper (0x99 misIdentifyMatchCmd)
+match_lib = static_library(
+  'match',
+  files('match.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_match_exe = executable(
+  'test_match',
+  files('tests/test_match.c'),
+  link_with: [match_lib, session_lib, tls_lib, crypto_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('match', test_match_exe)
+
+
+# Phase 10 — enroll FSM wrappers (0x96 sub-commands 01/02/03/04)
+enroll_lib = static_library(
+  'enroll',
+  files('enroll.c'),
+  include_directories: include_directories('.'),
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  c_args: ['-DVERIMARK_STANDALONE'],
+)
+
+test_enroll_exe = executable(
+  'test_enroll',
+  files('tests/test_enroll.c'),
+  link_with: [enroll_lib, session_lib, tls_lib, crypto_lib],
+  dependencies: [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep],
+  include_directories: include_directories('.'),
+)
+test('enroll', test_enroll_exe)
+
+
+# --- libfprint integration ------------------------------------------------
+#
+# When this driver lives inside a libfprint fork (= the present
+# context), the source files above are registered through
+# `libfprint/meson.build` of the fork — NOT through this file. This
+# standalone meson.build is kept so contributors can run the protocol-
+# layer unit tests independently of the libfprint build :
+#
+#   cd libfprint/drivers/verimark
+#   meson setup --werror build
+#   meson test -C build
+#
+# The libgusb-backed runtime helpers (verimark_handshake_runtime,
+# verimark_cli) and the broader probe/study tooling live in the project
+# monorepo under tools/ ; they are not shipped with the libfprint
+# fork.
