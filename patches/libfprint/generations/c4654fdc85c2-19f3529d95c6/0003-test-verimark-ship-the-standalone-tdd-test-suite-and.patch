+    ASSERT_EQ(info.count_class_3, 9);
+
+    /* The request must carry opcode 0x9e + 1-byte payload = class_byte. */
+    /* request record = [17 03 03 ll ll][nonce_explicit:8][ct:N][tag:16]
+     * plaintext inside = [opcode 0x9e][class 0x01] = 2 bytes
+     * encrypted payload size = 8 nonce + 2 plain + 16 tag = 26, body_len = 26
