+    VerimarkTransportIO io = { loopback_write, loopback_read, &ctx };
+    uint8_t tuid[16] = {0}, handle[16];
+    uint16_t status;
+    ASSERT_TRUE(!verimark_storage_resolve_template_to_handle(NULL, &io, tuid, handle, &status));
+    ASSERT_TRUE(!verimark_storage_resolve_template_to_handle(&s, NULL, tuid, handle, &status));
+    ASSERT_TRUE(!verimark_storage_resolve_template_to_handle(&s, &io, NULL, handle, &status));
+    ASSERT_TRUE(!verimark_storage_resolve_template_to_handle(&s, &io, tuid, NULL, &status));
+    ASSERT_TRUE(!verimark_storage_resolve_template_to_handle(&s, &io, tuid, handle, NULL));
+    verimark_session_zero(&s);
+    return 0;
+}
+
+
+/* ---- Test runner ------------------------------------------------------ */
+
+#define RUN(name) do { \
+    printf("  test_%s ... ", #name); \
+    int rc = test_##name(); \
+    if (rc == 0) { printf("OK\n"); passed++; } \
+    else { printf("FAIL\n"); failed++; } \
+} while (0)
+
+
+int main(void)
+{
+    int passed = 0, failed = 0;
+    setbuf(stdout, NULL);
+    setbuf(stderr, NULL);
+
+    RUN(get_db_info_decodes_counts_from_canned_response);
+    RUN(get_db_info_rejects_null_args);
+    RUN(get_db_info_propagates_sensor_error_status);
+    RUN(get_object_list_decodes_8_tuids);
+    RUN(get_object_list_truncates_over_cap);
+    RUN(get_object_list_rejects_truncated_payload);
+    RUN(get_object_info_decodes_10_bytes);
+    RUN(get_object_info_request_payload_layout);
+    RUN(delete_object_decodes_count);
+    RUN(delete_object_propagates_error_status);
+    RUN(delete_object_rejects_null_args);
+    RUN(delete_object_request_payload_layout);
+    RUN(resolve_decodes_storage_handle);
+    RUN(resolve_propagates_unknown_tuid_status);
+    RUN(resolve_rejects_null_args);
+
+    fprintf(stderr, "\n%d passed, %d failed\n", passed, failed);
+    return failed == 0 ? 0 : 1;
+}
diff --git a/libfprint/drivers/verimark/tests/test_tls.c b/libfprint/drivers/verimark/tests/test_tls.c
new file mode 100644
index 0000000..64bf67e
--- /dev/null
+++ b/libfprint/drivers/verimark/tests/test_tls.c
@@ -0,0 +1,317 @@
+/*
+ * test_tls.c — TDD tests for the TLS record + handshake layer.
+ *
+ * Cross-validates `verimark-tls.{h,c}` against the Python reference
+ * (`tools/tls_psk.py` + `tools/verimark_synaptics_handshake.py`) via test
+ * vectors generated by `tools/gen_crypto_test_vectors.py`.
+ *
+ * Compile via meson :
+ *   meson setup build && meson test -C build
+ *
+ * Exits 0 if all tests pass, non-zero otherwise.
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "tls.h"
+#include "tests/test_vectors.h"
+
+
+#define TEST(name) static int test_##name(void)
+
+#define ASSERT_EQ(a, b) do { \
+    if ((a) != (b)) { \
+        fprintf(stderr, "  %s:%d: ASSERT_EQ failed: %s (%ld) != %s (%ld)\n", \
+                __FILE__, __LINE__, #a, (long)(a), #b, (long)(b)); \
+        return 1; \
+    } \
+} while (0)
+
+#define ASSERT_MEM_EQ(a, b, n) do { \
+    if (memcmp((a), (b), (n)) != 0) { \
+        fprintf(stderr, "  %s:%d: ASSERT_MEM_EQ failed over %zu bytes\n", \
+                __FILE__, __LINE__, (size_t)(n)); \
+        for (size_t _i = 0; _i < (size_t)(n) && _i < 32; _i++) { \
+            fprintf(stderr, "    [%zu]  got=%02x  expected=%02x\n", \
+                    _i, ((const uint8_t*)(a))[_i], \
+                    ((const uint8_t*)(b))[_i]); \
+        } \
+        return 1; \
+    } \
+} while (0)
+
+#define ASSERT_TRUE(x) do { \
+    if (!(x)) { \
+        fprintf(stderr, "  %s:%d: ASSERT_TRUE failed: %s\n", \
+                __FILE__, __LINE__, #x); \
+        return 1; \
+    } \
+} while (0)
+
+
+/* ---- Record encode/decode ------------------------------------------------ */
+
+TEST(encode_record_handshake)
+{
+    /* Encode_record(CT_HANDSHAKE, TV_HS_CV_MSG) should match TV_HS_RECORD_HANDSHAKE */
+    uint8_t out[256];
+    size_t n = verimark_tls_encode_record(VERIMARK_CT_HANDSHAKE,
+                                          TV_HS_CV_MSG, TV_HS_CV_MSG_LEN,
+                                          out, sizeof(out));
+    ASSERT_EQ(n, TV_HS_RECORD_HANDSHAKE_LEN);
+    ASSERT_MEM_EQ(out, TV_HS_RECORD_HANDSHAKE, n);
+    return 0;
+}
+
+TEST(encode_record_buffer_too_small)
+{
+    uint8_t out[10];
+    size_t n = verimark_tls_encode_record(VERIMARK_CT_HANDSHAKE,
+                                          TV_HS_CV_MSG, TV_HS_CV_MSG_LEN,
+                                          out, sizeof(out));
+    ASSERT_EQ(n, 0);
+    return 0;
+}
+
+TEST(parse_record_handshake)
+{
+    uint8_t ct = 0;
+    uint16_t ver = 0;
+    const uint8_t *body = NULL;
+    size_t body_len = 0;
+    bool ok = verimark_tls_parse_record(TV_HS_RECORD_HANDSHAKE,
+                                        TV_HS_RECORD_HANDSHAKE_LEN,
+                                        &ct, &ver, &body, &body_len);
+    ASSERT_TRUE(ok);
+    ASSERT_EQ(ct, VERIMARK_CT_HANDSHAKE);
+    ASSERT_EQ(ver, VERIMARK_TLS_VERSION);
+    ASSERT_EQ(body_len, TV_HS_CV_MSG_LEN);
+    ASSERT_MEM_EQ(body, TV_HS_CV_MSG, body_len);
+    return 0;
+}
+
+TEST(parse_record_too_short)
+{
+    uint8_t buf[4] = { 0x16, 0x03, 0x03, 0x00 };
+    uint8_t ct = 0;
+    uint16_t ver = 0;
+    const uint8_t *body = NULL;
+    size_t body_len = 0;
+    bool ok = verimark_tls_parse_record(buf, 4, &ct, &ver, &body, &body_len);
+    ASSERT_TRUE(!ok);
+    return 0;
+}
+
+TEST(parse_record_body_truncated)
+{
+    /* record header says len=10 but only 5 bytes follow */
+    uint8_t buf[10] = { 0x16, 0x03, 0x03, 0x00, 0x0a, 1, 2, 3, 4, 5 };
+    uint8_t ct = 0;
+    uint16_t ver = 0;
+    const uint8_t *body = NULL;
+    size_t body_len = 0;
+    bool ok = verimark_tls_parse_record(buf, 10, &ct, &ver, &body, &body_len);
+    ASSERT_TRUE(!ok);
+    return 0;
+}
+
+
+/* ---- ClientHello builder ------------------------------------------------- */
+
+TEST(build_client_hello_byte_by_byte)
+{
+    uint8_t out[128];
+    size_t n = verimark_tls_build_client_hello(TV_HS_FIXED_CLIENT_RANDOM,
+                                                out, sizeof(out));
+    ASSERT_EQ(n, TV_HS_CLIENT_HELLO_RECORD_LEN);
+    ASSERT_MEM_EQ(out, TV_HS_CLIENT_HELLO_RECORD, n);
+    return 0;
+}
+
+TEST(build_client_hello_buffer_too_small)
+{
+    uint8_t out[40];
+    size_t n = verimark_tls_build_client_hello(TV_HS_FIXED_CLIENT_RANDOM,
+                                                out, sizeof(out));
+    ASSERT_EQ(n, 0);
+    return 0;
+}
+
+
+/* ---- Certificate body builder + wrap as HS msg --------------------------- */
+
+TEST(build_certificate_body_then_wrap)
+{
+    /* Build the body, then wrap with HS header, and compare to TV_HS_CERTIFICATE_MSG */
+    uint8_t body[408];
+    size_t body_n = verimark_tls_build_certificate_body(TV_HS_FAKE_CLIENT_CERT,
+                                                        body, sizeof(body));
+    ASSERT_EQ(body_n, 408);
+
+    uint8_t hs_msg[512];
+    size_t hs_n = verimark_tls_encode_handshake_msg(VERIMARK_HS_CERTIFICATE,
+                                                     body, body_n,
+                                                     hs_msg, sizeof(hs_msg));
+    ASSERT_EQ(hs_n, TV_HS_CERTIFICATE_MSG_LEN);
+    ASSERT_MEM_EQ(hs_msg, TV_HS_CERTIFICATE_MSG, hs_n);
+    return 0;
+}
+
+
+/* ---- ClientKeyExchange body builder + wrap ------------------------------- */
+
+TEST(build_cke_body_then_wrap)
+{
+    /* Build CKE body from a fake uncompressed pubkey, wrap, compare. */
+    /* The Python reference uses a deterministic eph_priv ; we extract its
+     * pubkey from TV_HS_CKE_MSG. Bytes [4..69] of TV_HS_CKE_MSG = `04 || X || Y`. */
+    const uint8_t *eph_pub_unc = TV_HS_CKE_MSG + 4;  /* skip HS hdr */
+
+    uint8_t body[65];
+    size_t body_n = verimark_tls_build_cke_body(eph_pub_unc, body, sizeof(body));
+    ASSERT_EQ(body_n, 65);
+
+    uint8_t hs_msg[80];
+    size_t hs_n = verimark_tls_encode_handshake_msg(VERIMARK_HS_CLIENT_KEY_EXCHANGE,
+                                                     body, body_n,
+                                                     hs_msg, sizeof(hs_msg));
+    ASSERT_EQ(hs_n, TV_HS_CKE_MSG_LEN);
+    ASSERT_MEM_EQ(hs_msg, TV_HS_CKE_MSG, hs_n);
+    return 0;
+}
+
+
+/* ---- CertificateVerify body builder + wrap ------------------------------- */
+
+TEST(build_cv_body_then_wrap)
+{
+    /* CV body = raw signature (no SignatureAndHash prefix). The Python TV uses
+     * a fixed 72-byte signature embedded at offset 4 of TV_HS_CV_MSG. */
+    const uint8_t *fixed_sig = TV_HS_CV_MSG + 4;
+    size_t fixed_sig_len = TV_HS_CV_MSG_LEN - 4;
+
+    uint8_t body[80];
+    size_t body_n = verimark_tls_build_cv_body(fixed_sig, fixed_sig_len,
+                                                body, sizeof(body));
+    ASSERT_EQ(body_n, fixed_sig_len);
+
+    uint8_t hs_msg[128];
+    size_t hs_n = verimark_tls_encode_handshake_msg(VERIMARK_HS_CERTIFICATE_VERIFY,
+                                                     body, body_n,
+                                                     hs_msg, sizeof(hs_msg));
+    ASSERT_EQ(hs_n, TV_HS_CV_MSG_LEN);
+    ASSERT_MEM_EQ(hs_msg, TV_HS_CV_MSG, hs_n);
+    return 0;
+}
+
+
+/* ---- Finished body builder ----------------------------------------------- */
+
+TEST(build_finished_body)
+{
+    /* Use the verify_data from TV_VERIFY_DATA (12 octets). */
+    uint8_t out[24];
+    size_t n = verimark_tls_build_finished_body(TV_VERIFY_DATA, TV_VERIFY_DATA_LEN,
+                                                 out, sizeof(out));
+    ASSERT_EQ(n, TV_HS_FINISHED_BODY_LEN);
+    ASSERT_MEM_EQ(out, TV_HS_FINISHED_BODY, n);
+    return 0;
+}
+
+
+/* ---- AAD GCM builder ----------------------------------------------------- */
+
+TEST(build_aad_gcm_seq0_handshake)
+{
+    uint8_t aad[16];
+    size_t n = verimark_tls_build_aad_gcm(0, VERIMARK_CT_HANDSHAKE,
+                                           VERIMARK_TLS_VERSION, 16,
+                                           aad, sizeof(aad));
+    ASSERT_EQ(n, 13);
+    ASSERT_MEM_EQ(aad, TV_HS_AAD_GCM_SEQ0, TV_HS_AAD_GCM_SEQ0_LEN);
+    return 0;
+}
+
+TEST(build_aad_gcm_buffer_too_small)
+{
+    uint8_t aad[10];
+    size_t n = verimark_tls_build_aad_gcm(0, VERIMARK_CT_HANDSHAKE,
+                                           VERIMARK_TLS_VERSION, 16,
+                                           aad, sizeof(aad));
+    ASSERT_EQ(n, 0);
+    return 0;
+}
+
+
+/* ---- ServerHello parser -------------------------------------------------- */
+
+TEST(parse_server_hello_synthetic)
+{
+    /* Synthetic SH body : 2 (ver) + 32 (random) + 1 (sid_len=7) + 7 (sid)
+     * + 2 (cipher 0xc02e) + 1 (comp=0) + extensions trailing.
+     */
+    uint8_t body[64];
+    body[0] = 0x03; body[1] = 0x83;  /* Synaptics negotiated version */
+    for (int i = 0; i < 32; i++) body[2 + i] = (uint8_t)i;
+    body[34] = 7;  /* sid_len */
+    memcpy(body + 35, "\x54\x4c\x53\x01\x02\x03\x04", 7);  /* "TLS"+4 */
+    body[42] = 0xc0; body[43] = 0x2e;
+    body[44] = 0x00;
+    /* leave 5 trailing trailing bytes — parser tolerates */
+    for (int i = 45; i < 64; i++) body[i] = 0;
+
+    uint8_t sr[32];
+    uint16_t cs = 0;
+    bool ok = verimark_tls_parse_server_hello(body, 64, sr, &cs);
+    ASSERT_TRUE(ok);
+    ASSERT_EQ(cs, 0xc02e);
+    for (int i = 0; i < 32; i++) ASSERT_EQ(sr[i], i);
+    return 0;
+}
+
+TEST(parse_server_hello_too_short)
+{
+    uint8_t body[10] = {0};
+    uint8_t sr[32];
+    uint16_t cs = 0;
+    bool ok = verimark_tls_parse_server_hello(body, 10, sr, &cs);
+    ASSERT_TRUE(!ok);
+    return 0;
+}
+
+
+/* ---- main runner --------------------------------------------------------- */
+
+#define RUN(name) do { \
+    int _r = test_##name(); \
+    if (_r != 0) { fprintf(stderr, "FAIL  %s\n", #name); failed++; } \
+    else         { fprintf(stdout, "ok    %s\n", #name); passed++; } \
+} while (0)
+
+int main(void)
+{
+    int passed = 0, failed = 0;
+    setbuf(stdout, NULL);
+    setbuf(stderr, NULL);
+
+    RUN(encode_record_handshake);
+    RUN(encode_record_buffer_too_small);
+    RUN(parse_record_handshake);
+    RUN(parse_record_too_short);
+    RUN(parse_record_body_truncated);
+    RUN(build_client_hello_byte_by_byte);
+    RUN(build_client_hello_buffer_too_small);
+    RUN(build_certificate_body_then_wrap);
+    RUN(build_cke_body_then_wrap);
+    RUN(build_cv_body_then_wrap);
+    RUN(build_finished_body);
+    RUN(build_aad_gcm_seq0_handshake);
+    RUN(build_aad_gcm_buffer_too_small);
+    RUN(parse_server_hello_synthetic);
+    RUN(parse_server_hello_too_short);
+
+    fprintf(stderr, "\n%d passed, %d failed\n", passed, failed);
+    return failed == 0 ? 0 : 1;
+}
