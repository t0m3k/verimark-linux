diff --git a/libfprint/drivers/verimark/tests/test_bootstrap.c b/libfprint/drivers/verimark/tests/test_bootstrap.c
new file mode 100644
index 0000000..ec7fd50
--- /dev/null
+++ b/libfprint/drivers/verimark/tests/test_bootstrap.c
@@ -0,0 +1,420 @@
+/*
+ * test_bootstrap.c — TDD tests for the pure host-side bootstrap builders.
+ *
+ * Reference vectors generated from python/verimark/bootstrap.py with
+ * fixed inputs (no randomness) so SHA-256 comparisons are bit-exact
+ * across implementations.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "bootstrap.h"
+
+
+#define TEST(name) static int test_##name(void)
+
+#define ASSERT_TRUE(x) do { \
+    if (!(x)) { \
+        fprintf(stderr, "  %s:%d: ASSERT_TRUE failed: %s\n", \
+                __FILE__, __LINE__, #x); \
+        return 1; \
+    } \
+} while (0)
+
+#define ASSERT_EQ(a, b) do { \
+    long _a = (long)(a), _b = (long)(b); \
+    if (_a != _b) { \
+        fprintf(stderr, "  %s:%d: ASSERT_EQ failed: %s (%ld) != %s (%ld)\n", \
+                __FILE__, __LINE__, #a, _a, #b, _b); \
+        return 1; \
+    } \
+} while (0)
+
+#define ASSERT_MEM_EQ(a, b, n) do { \
+    if (memcmp((a), (b), (n)) != 0) { \
+        fprintf(stderr, "  %s:%d: ASSERT_MEM_EQ failed over %zu bytes\n", \
+                __FILE__, __LINE__, (size_t)(n)); \
+        for (size_t _i = 0; _i < (size_t)(n) && _i < 32; _i++) \
+            fprintf(stderr, "    [%zu]  got=%02x  expected=%02x\n", \
+                    _i, ((const uint8_t*)(a))[_i], \
+                    ((const uint8_t*)(b))[_i]); \
+        return 1; \
+    } \
+} while (0)
+
+
+/* --- Fixed test vectors (must match the Python harness above) ---------- */
+
+static const uint8_t TEST_X_BE[32] = {
+    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+    0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,
+    0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f,
+};
+static const uint8_t TEST_Y_BE[32] = {
+    0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7,
+    0xa8, 0xa9, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf,
+    0xb0, 0xb1, 0xb2, 0xb3, 0xb4, 0xb5, 0xb6, 0xb7,
+    0xb8, 0xb9, 0xba, 0xbb, 0xbc, 0xbd, 0xbe, 0xbf,
+};
+static const uint8_t TEST_PRIV_BE[32] = {
+    0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
+    0x09, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16,
+    0x17, 0x18, 0x19, 0x20, 0x21, 0x22, 0x23, 0x24,
+    0x25, 0x26, 0x27, 0x28, 0x29, 0x30, 0x31, 0x32,
+};
+static const uint8_t TEST_SIG32[32] = {
+    0xde, 0xad, 0xbe, 0xef, 0xde, 0xad, 0xbe, 0xef,
+    0xde, 0xad, 0xbe, 0xef, 0xde, 0xad, 0xbe, 0xef,
+    0xde, 0xad, 0xbe, 0xef, 0xde, 0xad, 0xbe, 0xef,
+    0xde, 0xad, 0xbe, 0xef, 0xde, 0xad, 0xbe, 0xef,
+};
+/* DER ECDSA P-256 placeholder : SEQ(0x45) of two INTEGERs of 32 B each. */
+static const uint8_t TEST_DER[72] = {
+    0x30, 0x45,
+    0x02, 0x21, 0x00,
+    0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+    0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+    0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+    0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+    0x02, 0x20, 0x41,
+    0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb,
+    0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb,
+    0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb,
+    0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb, 0xbb,
+};
+
+
+/* --- 420-byte P-256 params blob ---------------------------------------- */
+
+TEST(p256_params_blob_header_and_size)
+{
+    uint8_t blob[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_p256_params_blob(
+        blob, sizeof(blob)));
+
+    /* First 16 bytes per python : 170000000001000001000000fcffffff */
+    static const uint8_t expected_header[16] = {
+        0x17, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
+        0x01, 0x00, 0x00, 0x00, 0xfc, 0xff, 0xff, 0xff,
+    };
+    ASSERT_MEM_EQ(blob, expected_header, 16);
+    return 0;
+}
+
+
+TEST(p256_params_blob_rejects_small_buffer)
+{
+    uint8_t blob[100];
+    ASSERT_TRUE(!verimark_bootstrap_build_p256_params_blob(
+        blob, sizeof(blob)));
+    return 0;
+}
+
+
+/* --- 400-byte storage client_cert -------------------------------------- */
+
+TEST(storage_cert_layout_first_24_bytes)
+{
+    uint8_t cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, cert, sizeof(cert)));
+
+    /* Python expects: 3f5f17002f2e2d2c2b2a292827262524232221201f1e1d1c */
+    static const uint8_t expected_first_24[24] = {
+        0x3f, 0x5f, 0x17, 0x00,                              /* magic + sensor_id */
+        0x2f, 0x2e, 0x2d, 0x2c, 0x2b, 0x2a, 0x29, 0x28,      /* reverse(x_be)[0..20] */
+        0x27, 0x26, 0x25, 0x24, 0x23, 0x22, 0x21, 0x20,
+        0x1f, 0x1e, 0x1d, 0x1c,
+    };
+    ASSERT_MEM_EQ(cert, expected_first_24, 24);
+    return 0;
+}
+
+
+TEST(storage_cert_signature_layout)
+{
+    uint8_t cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, cert, sizeof(cert)));
+
+    /* TLV header at +141 : tag=0x02, len=32 LE. */
+    ASSERT_EQ(cert[141], 0x02);
+    ASSERT_EQ(cert[142], 0x20);
+    ASSERT_EQ(cert[143], 0x00);
+    /* Signature payload at +144 (32 bytes). */
+    ASSERT_MEM_EQ(cert + 144, TEST_SIG32, 32);
+    /* Trailing zeros. */
+    static const uint8_t zero224[224] = {0};
+    ASSERT_MEM_EQ(cert + 176, zero224, 224);
+    return 0;
+}
+
+
+TEST(storage_cert_y_coordinate_at_offset_72)
+{
+    uint8_t cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, cert, sizeof(cert)));
+
+    /* y_be is 0xa0..0xbf BE → reversed = 0xbf..0xa0. */
+    uint8_t expected_y_le[32];
+    for (int i = 0; i < 32; i++)
+        expected_y_le[i] = TEST_Y_BE[31 - i];
+    ASSERT_MEM_EQ(cert + 72, expected_y_le, 32);
+    return 0;
+}
+
+
+TEST(storage_cert_rejects_short_buffer)
+{
+    uint8_t cert[100];
+    ASSERT_TRUE(!verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, cert, sizeof(cert)));
+    return 0;
+}
+
+
+/* --- 400-byte wire client_cert ----------------------------------------- */
+
+TEST(wire_cert_signature_layout)
+{
+    uint8_t cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_wire_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_DER, sizeof(TEST_DER),
+        cert, sizeof(cert)));
+
+    /* Python expects wire[140..150] = 000048003045022100aa
+     *   [140] = 00  (still in pad region)
+     *   [141] = 00  (wire sig tag, NOT 0x02)
+     *   [142] = 48  (len = 72 LE)
+     *   [143] = 00
+     *   [144..149] = 30 45 02 21 00 aa  (start of DER) */
+    static const uint8_t expected[10] = {
+        0x00, 0x00, 0x48, 0x00,
+        0x30, 0x45, 0x02, 0x21, 0x00, 0xaa,
+    };
+    ASSERT_MEM_EQ(cert + 140, expected, 10);
+    return 0;
+}
+
+
+TEST(wire_cert_first_24_match_storage)
+{
+    /* Magic + sensor_id + reverse(x) prefix : identical between wire
+     * and storage forms — only the signature region differs. */
+    uint8_t wire[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    ASSERT_TRUE(verimark_bootstrap_build_wire_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_DER, sizeof(TEST_DER),
+        wire, sizeof(wire)));
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, storage, sizeof(storage)));
+    ASSERT_MEM_EQ(wire, storage, 104);   /* up to start of pad-then-sig */
+    return 0;
+}
+
+
+TEST(wire_cert_rejects_oversized_signature)
+{
+    uint8_t cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t big_sig[260];
+    memset(big_sig, 0xcc, sizeof(big_sig));
+    ASSERT_TRUE(!verimark_bootstrap_build_wire_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, big_sig, sizeof(big_sig),
+        cert, sizeof(cert)));
+    return 0;
+}
+
+
+/* --- 802-byte pair response parser ------------------------------------- */
+
+TEST(parse_response_splits_into_header_and_certs)
+{
+    uint8_t resp[VERIMARK_BOOTSTRAP_PAIR_RESPONSE_SIZE];
+    /* Header 00 00 + 400 B 0xaa client_cert + 400 B 0xbb server_cert. */
+    resp[0] = 0x00; resp[1] = 0x00;
+    memset(resp + 2,                          0xaa, 400);
+    memset(resp + 2 + 400,                    0xbb, 400);
+
+    VerimarkBootstrapPairResponse out;
+    uint16_t status = 0xffff;
+    ASSERT_TRUE(verimark_bootstrap_parse_pair_response(
+        resp, sizeof(resp), &out, &status));
+    ASSERT_EQ(status, 0x0000);
+    ASSERT_EQ(out.header[0], 0x00);
+    ASSERT_EQ(out.header[1], 0x00);
+    for (int i = 0; i < 400; i++) {
+        ASSERT_EQ(out.client_cert_storage[i], 0xaa);
+        ASSERT_EQ(out.server_cert[i],         0xbb);
+    }
+    return 0;
+}
+
+
+TEST(parse_response_propagates_nonzero_status)
+{
+    uint8_t resp[VERIMARK_BOOTSTRAP_PAIR_RESPONSE_SIZE] = {0};
+    /* status 0x0406 (= already paired). */
+    resp[0] = 0x04; resp[1] = 0x06;
+    VerimarkBootstrapPairResponse out;
+    uint16_t status = 0;
+    bool ok = verimark_bootstrap_parse_pair_response(
+        resp, sizeof(resp), &out, &status);
+    ASSERT_TRUE(!ok);              /* explicit refusal */
+    ASSERT_EQ(status, 0x0406);
+    return 0;
+}
+
+
+TEST(parse_response_rejects_wrong_size)
+{
+    uint8_t small[100] = {0};
+    VerimarkBootstrapPairResponse out;
+    uint16_t status = 0;
+    ASSERT_TRUE(!verimark_bootstrap_parse_pair_response(
+        small, sizeof(small), &out, &status));
+    return 0;
+}
+
+
+/* --- 1284-byte sub1 TLV serialization ---------------------------------- */
+
+TEST(sub1_serialization_layout)
+{
+    uint8_t storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t server[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t p256[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE];
+    uint8_t sub1[VERIMARK_BOOTSTRAP_SUB1_SIZE];
+
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, storage, sizeof(storage)));
+    memset(server, 0xab, sizeof(server));
+    ASSERT_TRUE(verimark_bootstrap_build_p256_params_blob(p256, sizeof(p256)));
+
+    ASSERT_TRUE(verimark_bootstrap_serialize_sub1(
+        storage, TEST_PRIV_BE, server, p256, sub1, sizeof(sub1)));
+
+    /* Python : SUB1_FIRST24 = 020020000000323130292827262524232221201918171615
+     *   tag 2 LE = 02 00
+     *   length 32 LE = 20 00 00 00
+     *   priv LE = reverse(TEST_PRIV_BE)[:20]
+     *           = 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 16 15
+     *
+     * Note: my test priv (TEST_PRIV_BE) ends in
+     * "25 26 27 28 29 30 31 32" so reversed front is "32 31 30 29 28 27 26 25" */
+    static const uint8_t expected_first_24[24] = {
+        0x02, 0x00,
+        0x20, 0x00, 0x00, 0x00,
+        0x32, 0x31, 0x30, 0x29, 0x28, 0x27, 0x26, 0x25,
+        0x24, 0x23, 0x22, 0x21, 0x20, 0x19, 0x18, 0x17,
+        0x16, 0x15,
+    };
+    ASSERT_MEM_EQ(sub1, expected_first_24, 24);
+
+    /* Python : SUB1_LAST8 = 0000020000000000
+     *   tag 0 LE = 00 00
+     *   length 2 LE = 02 00 00 00
+     *   sentinel = 00 00 */
+    static const uint8_t expected_last_8[8] = {
+        0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00,
+    };
+    ASSERT_MEM_EQ(sub1 + VERIMARK_BOOTSTRAP_SUB1_SIZE - 8, expected_last_8, 8);
+
+    return 0;
+}
+
+
+TEST(sub1_offsets_per_tag)
+{
+    uint8_t storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t server[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t p256[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE];
+    uint8_t sub1[VERIMARK_BOOTSTRAP_SUB1_SIZE];
+
+    ASSERT_TRUE(verimark_bootstrap_build_storage_cert(
+        0x0017, TEST_X_BE, TEST_Y_BE, TEST_SIG32, storage, sizeof(storage)));
+    memset(server, 0xcd, sizeof(server));
+    ASSERT_TRUE(verimark_bootstrap_build_p256_params_blob(p256, sizeof(p256)));
+
+    ASSERT_TRUE(verimark_bootstrap_serialize_sub1(
+        storage, TEST_PRIV_BE, server, p256, sub1, sizeof(sub1)));
+
+    /* Tag layout offsets :
+     *   tag 2 (priv): off=0,                     hdr=6+32=38
+     *   tag 1 (cert): off=38,                    hdr=6+400=406  → next=444
+     *   tag 4 (p256): off=444,                   hdr=6+420=426  → next=870
+     *   tag 3 (srv ): off=870,                   hdr=6+400=406  → next=1276
+     *   tag 0 (end ): off=1276,                  hdr=6+2  =8    → next=1284 */
+
+    /* Tag 1 (cert) starts at offset 38 : tag=0x0001 LE + len=400 LE. */
+    ASSERT_EQ(sub1[38], 0x01);
+    ASSERT_EQ(sub1[39], 0x00);
+    ASSERT_EQ(sub1[40], 0x90);     /* 400 LE bytes 0..3 = 90 01 00 00 */
+    ASSERT_EQ(sub1[41], 0x01);
+    ASSERT_MEM_EQ(sub1 + 44, storage, 400);
+
+    /* Tag 4 (p256) starts at offset 444. */
+    ASSERT_EQ(sub1[444], 0x04);
+    ASSERT_EQ(sub1[445], 0x00);
+    ASSERT_MEM_EQ(sub1 + 444 + 6, p256, 420);
+
+    /* Tag 3 (server_cert) starts at offset 870. */
+    ASSERT_EQ(sub1[870], 0x03);
+    ASSERT_EQ(sub1[871], 0x00);
+    ASSERT_MEM_EQ(sub1 + 870 + 6, server, 400);
+    return 0;
+}
+
+
+TEST(sub1_rejects_short_buffer)
+{
+    uint8_t storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t server[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t p256[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE];
+    uint8_t small_sub1[100];
+    memset(storage, 0xaa, sizeof(storage));
+    memset(server,  0xbb, sizeof(server));
+    memset(p256,    0xcc, sizeof(p256));
+    ASSERT_TRUE(!verimark_bootstrap_serialize_sub1(
+        storage, TEST_PRIV_BE, server, p256,
+        small_sub1, sizeof(small_sub1)));
+    return 0;
+}
+
+
+#define RUN(name) do { \
+    printf("  test_%s ... ", #name); \
+    int rc = test_##name(); \
+    if (rc == 0) { printf("OK\n"); passed++; } \
+    else { printf("FAIL\n"); failed++; } \
+} while (0)
+
+
+int main(void)
+{
+    int passed = 0, failed = 0;
+    setbuf(stdout, NULL);
+    setbuf(stderr, NULL);
+
+    RUN(p256_params_blob_header_and_size);
+    RUN(p256_params_blob_rejects_small_buffer);
+    RUN(storage_cert_layout_first_24_bytes);
+    RUN(storage_cert_signature_layout);
+    RUN(storage_cert_y_coordinate_at_offset_72);
+    RUN(storage_cert_rejects_short_buffer);
+    RUN(wire_cert_signature_layout);
+    RUN(wire_cert_first_24_match_storage);
+    RUN(wire_cert_rejects_oversized_signature);
+    RUN(parse_response_splits_into_header_and_certs);
+    RUN(parse_response_propagates_nonzero_status);
+    RUN(parse_response_rejects_wrong_size);
+    RUN(sub1_serialization_layout);
+    RUN(sub1_offsets_per_tag);
+    RUN(sub1_rejects_short_buffer);
+
+    fprintf(stderr, "\n%d passed, %d failed\n", passed, failed);
+    return failed == 0 ? 0 : 1;
+}
