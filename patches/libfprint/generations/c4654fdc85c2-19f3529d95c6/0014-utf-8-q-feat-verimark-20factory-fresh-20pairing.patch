diff --git a/libfprint/drivers/verimark/bootstrap.c b/libfprint/drivers/verimark/bootstrap.c
new file mode 100644
index 0000000..d2e96fb
--- /dev/null
+++ b/libfprint/drivers/verimark/bootstrap.c
@@ -0,0 +1,289 @@
+/*
+ * bootstrap.c — Pure host-side builders for factory-fresh pairing.
+ *
+ * Implements the byte layouts documented in bootstrap.h. No crypto, no
+ * transport — those live in crypto.{h,c} and (later) the bootstrap
+ * orchestrator that wraps the 0x93 USB exchange.
+ */
+
+#include "bootstrap.h"
+
+#include <string.h>
+
+
+/* --- Little-endian writers --------------------------------------------- */
+
+static inline void write_le16(uint8_t out[2], uint16_t v)
+{
+    out[0] = (uint8_t)(v & 0xff);
+    out[1] = (uint8_t)((v >> 8) & 0xff);
+}
+
+static inline void write_le32(uint8_t out[4], uint32_t v)
+{
+    out[0] = (uint8_t)(v & 0xff);
+    out[1] = (uint8_t)((v >> 8) & 0xff);
+    out[2] = (uint8_t)((v >> 16) & 0xff);
+    out[3] = (uint8_t)((v >> 24) & 0xff);
+}
+
+
+/* --- BE byte-array reverse (for BE → LE conversion of P-256 coords) ---- */
+
+static void reverse_bytes(uint8_t *dst, const uint8_t *src, size_t n)
+{
+    for (size_t i = 0; i < n; i++)
+        dst[i] = src[n - 1 - i];
+}
+
+
+/* --- NIST P-256 standard constants (FIPS 186-4 §D.1.2.3 / SEC 2) -------
+ * 32-byte little-endian raw integers, exactly what the BCRYPT_ECC blob
+ * stores. Manually byte-reversed from the well-known big-endian hex
+ * representations.
+ */
+
+static const uint8_t P256_A_LE[32] = {
+    0xfc, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0xff, 0xff, 0xff, 0xff, 0xfe, 0xff, 0xff, 0xff,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
+};
+
+static const uint8_t P256_B_LE[32] = {
+    0x4b, 0x60, 0xd2, 0x27, 0x3e, 0x3c, 0xce, 0x3b,
+    0xf6, 0xb0, 0x53, 0xcc, 0xb0, 0x06, 0x1d, 0x65,
+    0xbc, 0x86, 0x98, 0x76, 0x55, 0xbd, 0xeb, 0xb3,
+    0xe7, 0x93, 0x3a, 0xaa, 0xd8, 0x35, 0xc6, 0x5a,
+};
+
+static const uint8_t P256_GX_LE[32] = {
+    0x96, 0xc2, 0x98, 0xd8, 0x45, 0x39, 0xa1, 0xf4,
+    0xa0, 0x33, 0xeb, 0x2d, 0x81, 0x7d, 0x03, 0x77,
+    0xf2, 0x40, 0xa4, 0x63, 0xe5, 0xe6, 0xbc, 0xf8,
+    0x47, 0x42, 0x2c, 0xe1, 0xf2, 0xd1, 0x17, 0x6b,
+};
+
+static const uint8_t P256_GY_LE[32] = {
+    0xf5, 0x51, 0xbf, 0x37, 0x68, 0x40, 0xb6, 0xcb,
+    0xce, 0x5e, 0x31, 0x6b, 0x57, 0x33, 0xce, 0x2b,
+    0x16, 0x9e, 0x0f, 0x7c, 0x4a, 0xeb, 0xe7, 0x8e,
+    0x9b, 0x7f, 0x1a, 0xfe, 0xe2, 0x42, 0xe3, 0x4f,
+};
+
+static const uint8_t P256_N_LE[32] = {
+    0x51, 0x25, 0x63, 0xfc, 0xc2, 0xca, 0xb9, 0xf3,
+    0x84, 0x9e, 0x17, 0xa7, 0xad, 0xfa, 0xe6, 0xbc,
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
+};
+
+static const uint8_t P256_P_LE[32] = {
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
+};
+
+
+/* --- 420-byte P-256 BCRYPT params blob --------------------------------- */
+
+bool verimark_bootstrap_build_p256_params_blob(
+    uint8_t *out, size_t out_size)
+{
+    if (!out || out_size < VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE)
+        return false;
+
+    memset(out, 0, VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE);
+
+    /* Header (12 bytes) : [version u32 LE = 0x17][bits u32 LE = 0x100][1 u32 LE] */
+    write_le32(out + 0,  0x17u);
+    write_le32(out + 4,  0x0100u);
+    write_le32(out + 8,  1u);
+
+    /* A coefficient @ +12 (32 B), then 36 zeros pad. */
+    memcpy(out + 12, P256_A_LE, 32);
+    /* (zeros 44..79 already by memset) */
+
+    /* Then 5 blocks of (32 LE value + 36 zero pad) for B, Gx, Gy, N, P. */
+    static const uint8_t *blocks[5] = {
+        P256_B_LE, P256_GX_LE, P256_GY_LE, P256_N_LE, P256_P_LE,
+    };
+    size_t off = 80;   /* 12 hdr + 32 A + 36 pad */
+    for (size_t i = 0; i < 5; i++) {
+        memcpy(out + off, blocks[i], 32);
+        /* off+32..off+67 already zero from memset */
+        off += 68;
+    }
+    /* Final off should be 80 + 5*68 = 420. */
+    return true;
+}
+
+
+/* --- 400-byte storage client_cert -------------------------------------- */
+
+#define MAGIC_LE_0   0x3fu
+#define MAGIC_LE_1   0x5fu
+#define STORAGE_SIG_TAG 0x02u
+#define STORAGE_SIG_LEN 32u
+#define STORAGE_SIG_OFFSET 144u
+
+bool verimark_bootstrap_build_storage_cert(
+    uint16_t sensor_id_short,
+    const uint8_t pubkey_x_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t pubkey_y_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t signature_32[VERIMARK_BOOTSTRAP_P256_STORAGE_SIG_LEN],
+    uint8_t *out, size_t out_size)
+{
+    if (!out || out_size < VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE
+        || !pubkey_x_be || !pubkey_y_be || !signature_32)
+        return false;
+
+    memset(out, 0, VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+
+    /* [0..2] magic u16 LE = 0x5f3f */
+    out[0] = MAGIC_LE_0;
+    out[1] = MAGIC_LE_1;
+    /* [2..4] sensor_id_short LE */
+    write_le16(out + 2, sensor_id_short);
+    /* [4..36] pubkey_x in LE (= reverse of BE) */
+    reverse_bytes(out + 4,  pubkey_x_be, 32);
+    /* [36..72] zeros (already from memset) */
+    /* [72..104] pubkey_y in LE */
+    reverse_bytes(out + 72, pubkey_y_be, 32);
+    /* [104..141] zeros */
+    /* [141] storage sig tag */
+    out[141] = STORAGE_SIG_TAG;
+    /* [142..144] sig length LE = 32 */
+    write_le16(out + 142, STORAGE_SIG_LEN);
+    /* [144..176] signature bytes */
+    memcpy(out + STORAGE_SIG_OFFSET, signature_32, STORAGE_SIG_LEN);
+    /* [176..400] zeros */
+
+    return true;
+}
+
+
+/* --- 400-byte wire client_cert (with DER signature) -------------------- */
+
+#define WIRE_SIG_TAG    0x00u
+#define WIRE_SIG_OFFSET 144u
+#define WIRE_SIG_MAX    (VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE - WIRE_SIG_OFFSET)  /* 256 */
+
+bool verimark_bootstrap_build_wire_cert(
+    uint16_t sensor_id_short,
+    const uint8_t pubkey_x_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t pubkey_y_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t *der_signature, size_t der_signature_len,
+    uint8_t *out, size_t out_size)
+{
+    if (!out || out_size < VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE
+        || !pubkey_x_be || !pubkey_y_be || !der_signature)
+        return false;
+    if (der_signature_len == 0 || der_signature_len > WIRE_SIG_MAX)
+        return false;
+
+    memset(out, 0, VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+
+    out[0] = MAGIC_LE_0;
+    out[1] = MAGIC_LE_1;
+    write_le16(out + 2, sensor_id_short);
+    reverse_bytes(out + 4,  pubkey_x_be, 32);
+    reverse_bytes(out + 72, pubkey_y_be, 32);
+    /* [141] = WIRE_SIG_TAG = 0x00 (already zero) */
+    write_le16(out + 142, (uint16_t)der_signature_len);
+    memcpy(out + WIRE_SIG_OFFSET, der_signature, der_signature_len);
+
+    return true;
+}
+
+
+/* --- 802-byte pair response parser ------------------------------------- */
+
+bool verimark_bootstrap_parse_pair_response(
+    const uint8_t *response, size_t response_len,
+    VerimarkBootstrapPairResponse *out,
+    uint16_t *out_status)
+{
+    if (!response || !out_status)
+        return false;
+    if (response_len != VERIMARK_BOOTSTRAP_PAIR_RESPONSE_SIZE)
+        return false;
+
+    /* Header is u16 BE (Tudor convention) — extract status before
+     * deciding whether to populate `out`. */
+    *out_status = (uint16_t)((response[0] << 8) | response[1]);
+
+    if (!out)
+        return *out_status == 0x0000;
+
+    out->header[0] = response[0];
+    out->header[1] = response[1];
+    memcpy(out->client_cert_storage, response + 2,
+           VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+    memcpy(out->server_cert, response + 2 + VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE,
+           VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+
+    return *out_status == 0x0000;
+}
+
+
+/* --- 1284-byte sub1 TLV serialization ---------------------------------- */
+
+/* TLV record header : [tag:u16 LE][length:u32 LE]. */
+#define SUB1_TAG_HDR 6u
+
+static size_t write_tlv(uint8_t *out, uint16_t tag,
+                         const uint8_t *value, uint32_t len)
+{
+    write_le16(out, tag);
+    write_le32(out + 2, len);
+    if (len > 0)
+        memcpy(out + 6, value, len);
+    return SUB1_TAG_HDR + len;
+}
+
+bool verimark_bootstrap_serialize_sub1(
+    const uint8_t client_cert_storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE],
+    const uint8_t client_priv_be[VERIMARK_BOOTSTRAP_P256_PRIV_LEN],
+    const uint8_t server_cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE],
+    const uint8_t p256_params[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE],
+    uint8_t *out, size_t out_size)
+{
+    if (!client_cert_storage || !client_priv_be || !server_cert
+        || !p256_params || !out
+        || out_size < VERIMARK_BOOTSTRAP_SUB1_SIZE)
+        return false;
+
+    size_t off = 0;
+
+    /* Tag 2 : client_priv_be reversed to LE (sensor convention). */
+    uint8_t priv_le[VERIMARK_BOOTSTRAP_P256_PRIV_LEN];
+    reverse_bytes(priv_le, client_priv_be, VERIMARK_BOOTSTRAP_P256_PRIV_LEN);
+    off += write_tlv(out + off, 2, priv_le,
+                     VERIMARK_BOOTSTRAP_P256_PRIV_LEN);
+
+    /* Tag 1 : client_cert (storage format). */
+    off += write_tlv(out + off, 1, client_cert_storage,
+                     VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+
+    /* Tag 4 : P-256 params blob. */
+    off += write_tlv(out + off, 4, p256_params,
+                     VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE);
+
+    /* Tag 3 : server_cert. */
+    off += write_tlv(out + off, 3, server_cert,
+                     VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE);
+
+    /* Tag 0 : sentinel "\x00\x00" length 2. */
+    static const uint8_t sentinel[2] = { 0x00, 0x00 };
+    off += write_tlv(out + off, 0, sentinel, 2);
+
+    /* Sanity : 38 + 406 + 426 + 406 + 8 = 1284. */
+    if (off != VERIMARK_BOOTSTRAP_SUB1_SIZE)
+        return false;
+
+    /* Wipe the temporary LE-priv copy from the stack. */
+    memset(priv_le, 0, sizeof(priv_le));
+    return true;
+}
diff --git a/libfprint/drivers/verimark/bootstrap.h b/libfprint/drivers/verimark/bootstrap.h
new file mode 100644
index 0000000..cec79e7
--- /dev/null
+++ b/libfprint/drivers/verimark/bootstrap.h
@@ -0,0 +1,188 @@
+/*
+ * bootstrap.h — Factory-fresh pairing for the Kensington VeriMark DT.
+ *
+ * Builds the host-side data structures needed to perform the initial
+ * `0x93 DoPairBasic` exchange and persist the resulting Synaptics sub1
+ * pairing blob. Mirrors `python/verimark/bootstrap.py` byte-for-byte.
+ *
+ * This header exposes only the PURE host-side functions (cert
+ * layout, sub1 TLV serialization, P-256 params blob, response
+ * parsing). Crypto (ECDSA-P256 sign + pubkey derive) lives in
+ * crypto.{h,c} ; transport (0x93 over USB) and the bootstrap
+ * orchestrator live in bootstrap.c proper.
+ *
+ * TOFU model — sensor accepts any client_pubkey the first time
+ * 0x93 is sent. Subsequent 0x93 attempts against an already-paired
+ * sensor fail.
+ *
+ * Cf. docs/phase8b-bootstrap-pairing.md, docs/opcodes/0x93.yaml.
+ */
+
+#ifndef VERIMARK_BOOTSTRAP_H
+#define VERIMARK_BOOTSTRAP_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+/* --- Sizes --------------------------------------------------------------- */
+
+#define VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE   400u
+#define VERIMARK_BOOTSTRAP_PAIR_RESPONSE_SIZE 802u
+#define VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE   420u
+#define VERIMARK_BOOTSTRAP_SUB1_SIZE          1284u
+
+#define VERIMARK_BOOTSTRAP_P256_COORD_LEN     32u
+#define VERIMARK_BOOTSTRAP_P256_PRIV_LEN      32u
+#define VERIMARK_BOOTSTRAP_P256_STORAGE_SIG_LEN 32u
+
+/* Lower 16 bits of the sensor's 4-byte ID. The VeriMark DT family
+ * uses 0x0017 ; can be overridden when targeting a different short
+ * ID. (Sensor self-reports the full ID via opcode 0x01.) */
+#define VERIMARK_BOOTSTRAP_DEFAULT_SENSOR_ID_SHORT 0x0017u
+
+
+/* --- 420-byte BCRYPT_ECC P-256 parameter blob (sub1 tag 4) -------------- */
+
+/**
+ * Build the 420-byte BCRYPT_ECC_PARAMETER blob that sub1 tag 4 holds.
+ * Layout is invariant across all VeriMark DT sensors (it encodes
+ * standard NIST P-256 parameters — A, B, Gx, Gy, N, P — in the
+ * BCRYPT little-endian format). Nothing sensor-specific.
+ *
+ * Output buffer must be at least VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE
+ * (420) bytes ; returns FALSE if the buffer is too small.
+ */
+bool verimark_bootstrap_build_p256_params_blob(
+    uint8_t *out, size_t out_size);
+
+
+/* --- 400-byte client_cert (storage format) ------------------------------ */
+
+/**
+ * Build the STORAGE-format client_cert (sub1 tag 1).
+ *
+ * Layout (400 bytes) :
+ *   [  0..  1] u16 LE magic = 0x5f3f (= bytes 3f 5f)
+ *   [  2..  3] u16 LE sensor_id_short
+ *   [  4.. 35] 32 B pubkey_x in LE (= reverse of math BE form)
+ *   [ 36.. 71] 36 B zeros
+ *   [ 72..103] 32 B pubkey_y in LE
+ *   [104..140] 37 B zeros
+ *   [    141 ]  u8 signature TLV tag = 0x02
+ *   [142..143] u16 LE signature length = 32
+ *   [144..175] 32 B signature
+ *   [176..399] 224 B zeros
+ *
+ * `pubkey_x_be` / `pubkey_y_be` are the mathematical big-endian
+ * coordinates (matching the gnutls / nettle convention).
+ * `signature_32` is the 32-byte signature stored verbatim — for a
+ * fresh bootstrap, can be any 32-byte placeholder (sensor doesn't
+ * verify the storage cert).
+ *
+ * Returns FALSE on size mismatch / NULL arg.
+ */
+bool verimark_bootstrap_build_storage_cert(
+    uint16_t sensor_id_short,
+    const uint8_t pubkey_x_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t pubkey_y_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t signature_32[VERIMARK_BOOTSTRAP_P256_STORAGE_SIG_LEN],
+    uint8_t *out, size_t out_size);
+
+
+/* --- 400-byte client_cert (wire format, signed) ------------------------ */
+
+/**
+ * Build the WIRE-format client_cert (sent as `0x93` payload).
+ *
+ * Identical to the storage format EXCEPT :
+ *   - byte [141] = 0x00 (not 0x02)
+ *   - bytes [142..143] = DER signature length in LE
+ *   - bytes [144..(144+der_len)] = DER-encoded ECDSA P-256 signature
+ *
+ * `der_signature` is the standard DER-encoded ECDSA signature
+ * (typically 70-72 bytes for P-256). Must fit in
+ * 400 - 144 = 256 bytes.
+ *
+ * Returns FALSE on size mismatch / signature too large.
+ */
+bool verimark_bootstrap_build_wire_cert(
+    uint16_t sensor_id_short,
+    const uint8_t pubkey_x_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t pubkey_y_be[VERIMARK_BOOTSTRAP_P256_COORD_LEN],
+    const uint8_t *der_signature, size_t der_signature_len,
+    uint8_t *out, size_t out_size);
+
+
+/* --- Parse the 802-byte 0x93 response ----------------------------------- */
+
+/**
+ * Parsed components of a successful 0x93 IN response.
+ *
+ * Layout of the 802-byte response :
+ *   [  0..  1] status header (00 00 on success)
+ *   [  2..401] storage-format client_cert as the sensor would store it
+ *              (echoed back to the host with a sensor-side signature
+ *              that no one verifies)
+ *   [402..801] WIRE-format server_cert signed by the sensor's permanent
+ *              long-term key — this is what gets persisted as sub1 tag 3
+ */
+typedef struct {
+    uint8_t header[2];
+    uint8_t client_cert_storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+    uint8_t server_cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE];
+} VerimarkBootstrapPairResponse;
+
+/**
+ * Split a 0x93 IN response into its 3 components. Caller must pass
+ * exactly VERIMARK_BOOTSTRAP_PAIR_RESPONSE_SIZE bytes.
+ *
+ * Returns FALSE on wrong size or a non-zero status header (the
+ * sensor refused the pairing — typically because it's already
+ * paired). `*out_status` is populated regardless so the caller can
+ * interpret the error.
+ */
+bool verimark_bootstrap_parse_pair_response(
+    const uint8_t *response, size_t response_len,
+    VerimarkBootstrapPairResponse *out,
+    uint16_t *out_status);
+
+
+/* --- Serialize a sub1 TLV blob ----------------------------------------- */
+
+/**
+ * Build a sub1 pairing blob from its 4 canonical components.
+ *
+ * Tags are written in the order observed in real sub1 (2, 1, 4, 3, 0) :
+ *   tag 2  client private scalar (32 bytes LE = reverse of BE form)
+ *   tag 1  client_cert in storage format (400 B)
+ *   tag 4  P-256 BCRYPT params blob (420 B)
+ *   tag 3  server_cert (400 B, exactly what came back from 0x93 IN)
+ *   tag 0  sentinel "\x00\x00" (length 2)
+ *
+ * Each TLV record uses a 6-byte header : `[tag:u16 LE][length:u32 LE]`.
+ * Total: 1284 bytes exactly.
+ *
+ * `client_priv_be` is the 32-byte big-endian private scalar (the
+ * host's secret).
+ *
+ * Returns FALSE on size mismatch / NULL arg.
+ */
+bool verimark_bootstrap_serialize_sub1(
+    const uint8_t client_cert_storage[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE],
+    const uint8_t client_priv_be[VERIMARK_BOOTSTRAP_P256_PRIV_LEN],
+    const uint8_t server_cert[VERIMARK_BOOTSTRAP_CLIENT_CERT_SIZE],
+    const uint8_t p256_params[VERIMARK_BOOTSTRAP_P256_PARAMS_SIZE],
+    uint8_t *out, size_t out_size);
+
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* VERIMARK_BOOTSTRAP_H */
diff --git a/libfprint/drivers/verimark/meson.build b/libfprint/drivers/verimark/meson.build
