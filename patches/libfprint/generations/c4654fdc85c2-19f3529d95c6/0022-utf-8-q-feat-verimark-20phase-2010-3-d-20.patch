-/**
- * Run the canonical preamble + per-attempt capture sequence + 0x99
- * match call, with a polling loop on 0x87 to wait for the frame
- * ready event. Returns TRUE on a positive verdict (match), FALSE
- * otherwise. On a definitive failure (no finger / sensor error),
- * sets `*out_err` and returns FALSE.
+/* ========================================================================
+ * Phase 10.3.d — async verify/identify SSM
+ * ========================================================================
  *
- * On positive verdict, the 16-byte class-2 matched_tuid is copied
- * into `out_matched_tuid` so callers (verify/identify) can resolve
- * it back to the class-1 storage_handle that libfprint compares
- * against.
- */
-/**
- * 7-opcode inter-attempt drain (between verify retries). Mirrors
- * python `_inter_attempt_drain`. Cursors advance by 4 per drain.
+ * Replaces the previous synchronous `verimark_run_capture_match_pipeline`
+ * which blocked the libfprint GMainLoop for up to ~90 s (30 s × 3
+ * attempts) during the 0x87 polling cycle. The DBus client (fprintd-CLI)
+ * has a 25 s reply deadline on `VerifyStart` → any blocking poll past
+ * that triggered "timeout exceeded" client-side. Ctrl+C / VerifyStop
+ * also could not be dispatched until the poll returned.
+ *
+ * Architecture :
+ *   - Each Tudor opcode is one async call via
+ *     `verimark_session_call_opcode_async()` (Phase 10.3.b).
+ *   - The poll loop becomes a state pair (`POLL_READ` / `POLL_WAIT`) that
+ *     re-fires `event_read` every 250 ms via `g_timeout_add` until
+ *     frame_ready, false-detect (RICH only), or the 30 s per-attempt
+ *     deadline.
+ *   - The 500 ms inter-attempt sleep is also a `g_timeout_add`.
+ *   - The 0xa0 02 resolve (matched_tuid → storage_handle) runs as the
+ *     last SSM state on positive match.
+ *   - Verify and identify share one SSM ; `fpi_device_get_current_action()`
+ *     in the done callback dispatches the verdict (verify_report vs
+ *     identify_report, gallery_hit lookup vs requested-print compare).
  */
+
+#define VERIMARK_VERIFY_DRAIN_SLEEP_MS   500
+/* VERIMARK_VERIFY_POLL_INTERVAL_MS / VERIMARK_VERIFY_TIMEOUT_S /
+ * VERIMARK_VERIFY_MAX_ATTEMPTS — already defined in the legacy sync
+ * block below ; reused here. */
+
+typedef enum {
+    /* --- Preamble (4 ops) --- */
+    VFY_S_PRE_INIT_0X19,
+    VFY_S_PRE_EVCFG_ON,
+    VFY_S_PRE_EVREAD,
+    VFY_S_PRE_EVCFG_RESET,
+
+    /* --- Attempt loop dispatch (sync, no opcode) --- */
+    VFY_S_ATTEMPT_BEGIN,
+
+    /* --- Inter-attempt drain (7 ops + 1 sleep, only on retry) --- */
+    VFY_S_DRAIN_CFG_WARM,
+    VFY_S_DRAIN_EVCFG_ON,
+    VFY_S_DRAIN_EVREAD_A,
+    VFY_S_DRAIN_EVCFG_RESET_A,
+    VFY_S_DRAIN_EVCFG_E2,
+    VFY_S_DRAIN_EVREAD_B,
+    VFY_S_DRAIN_EVCFG_RESET_B,
+    VFY_S_DRAIN_SLEEP,            /* g_timeout 500 ms */
+
+    /* --- Per-attempt setup (3-4 ops) --- */
+    VFY_S_CFG_WARM_OPT,           /* only on retry — sync-dispatched */
+    VFY_S_CFG_RICH,
+    VFY_S_EVCFG_ARM,
+    VFY_S_CAPSTART,
+
+    /* --- Poll loop --- */
+    VFY_S_POLL_READ,
+    VFY_S_POLL_WAIT,              /* g_timeout 250 ms */
+
+    /* --- Per-attempt teardown (3 ops) --- */
+    VFY_S_CFG_SPARSE,
+    VFY_S_EVCFG_RESET,
+    VFY_S_STATUS_POLL,
+
+    /* --- After-poll dispatch (sync) --- */
+    VFY_S_AFTER_POLL,
+
+    /* --- Match (1 op) + dispatch --- */
+    VFY_S_MATCH,
+    VFY_S_AFTER_MATCH,
+    VFY_S_CFG_WARM_NO_MATCH,      /* 0x39 WARM red-LED feedback */
+
+    /* --- Postamble (7 ops, always) --- */
+    VFY_S_POST_CFG_MIXED,
+    VFY_S_POST_EVCFG_ON,
+    VFY_S_POST_EVREAD,
+    VFY_S_POST_EVCFG_RESET_A,
+    VFY_S_POST_EVCFG_E2,
+    VFY_S_POST_CFG_SPARSE,
+    VFY_S_POST_EVCFG_RESET_B,
+
+    /* --- Resolve (1 op, only if matched) + sync dispatch --- */
+    VFY_S_RESOLVE_DISPATCH,
+    VFY_S_RESOLVE_CALL,
+
+    VFY_S_LAST,
+} VerifyState;
+
+
+typedef struct {
+    /* Result fields — populated as the SSM progresses, consumed in
+     * the done callback. */
+    gboolean frame_ready;                                 /* ANY attempt saw a finger */
+    gboolean matched;                                     /* sensor verdict ≥ 16 B */
+    uint8_t  matched_tuid[VERIMARK_STORAGE_TUID_LEN];    /* class-2 ID */
+    uint8_t  resolved_handle[VERIMARK_STORAGE_TUID_LEN]; /* class-1 ID */
+    uint16_t resolve_status;
+    gboolean resolve_ok;
+
+    /* Attempt-loop state. */
+    int      attempt;                  /* 1..VERIMARK_VERIFY_MAX_ATTEMPTS */
+    int      poll_count;               /* total polls this attempt */
+    gint64   poll_deadline_us;         /* g_get_monotonic_time() + 30 s */
+    gboolean frame_ready_this_attempt;
+    gboolean saw_false_detect;         /* RICH mode early-exit trigger */
+
+    /* Pending GLib timer source — non-zero between schedule and fire.
+     * Cleared by the SSM done callback so a late firing can't poke a
+     * dead SSM. */
+    guint    pending_timer_id;
+} VerimarkVerifyCtx;
+
