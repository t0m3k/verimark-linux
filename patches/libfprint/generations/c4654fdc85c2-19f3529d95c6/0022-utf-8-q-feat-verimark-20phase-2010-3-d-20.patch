+                                        FP_DEVICE_RETRY_TOO_SHORT,
+                                        "verify: no finger detected after %d attempts",
+                                        VERIMARK_VERIFY_MAX_ATTEMPTS);
+            fpi_device_verify_report(dev, FPI_MATCH_ERROR, NULL,
+                                     g_steal_pointer(&retry));
+            fpi_device_verify_complete(dev, NULL);
+        }
+    } else { /* IDENTIFY */
+        FpPrint *gallery_hit = NULL;
+        if (reported_match && ctx->resolve_ok
+            && ctx->resolve_status == 0x0000) {
+            GPtrArray *gallery = NULL;
+            fpi_device_get_identify_data(dev, &gallery);
+            gallery_hit = verimark_gallery_find_by_tuid(gallery,
+                                                        ctx->resolved_handle);
+        }
+        if (gallery_hit) {
+            fpi_device_identify_report(dev, gallery_hit, NULL, NULL);
+            fpi_device_identify_complete(dev, NULL);
+        } else if (ctx && ctx->frame_ready) {
+            /* Finger seen, no gallery hit (or resolver failed). */
+            fpi_device_identify_report(dev, NULL, NULL, NULL);
+            fpi_device_identify_complete(dev, NULL);
+        } else {
+            GError *retry = g_error_new(FP_DEVICE_RETRY,
+                                        FP_DEVICE_RETRY_TOO_SHORT,
+                                        "identify: no finger detected after %d attempts",
+                                        VERIMARK_VERIFY_MAX_ATTEMPTS);
+            fpi_device_identify_report(dev, NULL, NULL,
+                                       g_steal_pointer(&retry));
+            fpi_device_identify_complete(dev, NULL);
+        }
+    }
+
+    self->task_ssm = NULL;
+    self->verify_ctx = NULL;
+}
+
+
+/* ---- ctx free (called by fpi_ssm on completion) ------------------------ */
+
+static void
+verify_ctx_free(gpointer data)
+{
+    VerimarkVerifyCtx *ctx = data;
+    if (ctx == NULL) return;
+    if (ctx->pending_timer_id != 0) {
+        g_source_remove(ctx->pending_timer_id);
+        ctx->pending_timer_id = 0;
+    }
+    g_free(ctx);
+}
+
+
+/* ---- SSM entry (shared by verify and identify vfuncs) ------------------ */
+
+static void
+verimark_run_verify_ssm(FpDevice *device)
+{
+    FpiDeviceVerimark *self = FPI_DEVICE_VERIMARK(device);
+
+    if (!self->session_active) {
+        GError *err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                                  "verify: TLS session not active");
+        if (fpi_device_get_current_action(device) == FPI_DEVICE_ACTION_VERIFY)
+            fpi_device_verify_complete(device, err);
+        else
+            fpi_device_identify_complete(device, err);
+        return;
+    }
+
+    VerimarkVerifyCtx *ctx = g_new0(VerimarkVerifyCtx, 1);
+    ctx->attempt = 1;
+
+    self->task_ssm = fpi_ssm_new(device, verify_sm_run_state, VFY_S_LAST);
+    fpi_ssm_set_data(self->task_ssm, ctx, verify_ctx_free);
+    self->verify_ctx = ctx;
+    fpi_ssm_start(self->task_ssm, verify_sm_done);
+}
