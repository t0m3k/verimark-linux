-        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
-                               "verify: 0x19 init transport failure");
-        return FALSE;
+    FpiSsm *ssm = (FpiSsm *)ud;
+    VerimarkVerifyCtx *ctx = fpi_ssm_get_data(ssm);
+    ctx->pending_timer_id = 0;
+    /* Has the per-attempt deadline expired ? */
+    if (g_get_monotonic_time() >= ctx->poll_deadline_us) {
+        fp_dbg("verify: attempt %d poll deadline reached (count=%d)",
+               ctx->attempt, ctx->poll_count);
