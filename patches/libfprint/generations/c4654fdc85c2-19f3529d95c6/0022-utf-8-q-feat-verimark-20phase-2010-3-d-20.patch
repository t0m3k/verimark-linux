+}
+
+
+/* ---- 0x87 event-read payload helper ------------------------------------- */
+
+static void
+vfy_build_evread_payload(uint16_t cursor, uint16_t max_events,
+                          uint8_t out[8])
+{
+    out[0] = (uint8_t)(cursor & 0xff);
+    out[1] = (uint8_t)((cursor >> 8) & 0xff);
+    out[2] = (uint8_t)(max_events & 0xff);
+    out[3] = (uint8_t)((max_events >> 8) & 0xff);
+    out[4] = 0x01;            /* field_05 = 1 */
+    out[5] = 0x00;
+    out[6] = 0x00;
+    out[7] = 0x00;
+}
+
+
+/* ---- 0xa0 02 resolve payload helper ------------------------------------- */
+
+static void
+vfy_build_resolve_payload(const uint8_t matched_tuid[VERIMARK_STORAGE_TUID_LEN],
+                           uint8_t out[20])
+{
+    memset(out, 0, 20);
+    out[0] = 0x02;            /* class byte = 2 (templates) */
+    memcpy(out + 4, matched_tuid, VERIMARK_STORAGE_TUID_LEN);
+}
+
+
+/* ---- 0x99 match payload (constant) -------------------------------------- */
+
+static const uint8_t VFY_MATCH_PAYLOAD[12] = {
+    0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+
+/* ---- forward decls ----------------------------------------------------- */
+
+static void verify_sm_run_state(FpiSsm *ssm, FpDevice *dev);
+static void verify_sm_done(FpiSsm *ssm, FpDevice *dev, GError *error);
+static void verify_ctx_free(gpointer data);
+
+
+/* ---- Generic opcode callbacks ------------------------------------------ *
+ *
+ * Every async call_opcode_async finish lands in one of these. The body
+ * pattern is identical : finish → on error mark_failed ; on success
+ * stash any state-specific result, free the payload, advance the SSM.
+ */
+
+/* "Just check OK and advance" — used for ops whose response we ignore. */
+static void
+vfy_cb_advance(GObject *src, GAsyncResult *res, gpointer ud)
+{
+    (void)src;
+    FpiSsm *ssm = (FpiSsm *)ud;
+    uint16_t status = 0;
+    uint8_t *payload = NULL;
+    size_t   payload_len = 0;
+    GError  *err = NULL;
+    if (!verimark_session_call_opcode_finish(res, &status, &payload,
+                                              &payload_len, &err)) {
+        fpi_ssm_mark_failed(ssm, err);
+        return;
+    }
+    g_free(payload);
+    /* We accept any Tudor status — most setup/teardown ops are best-effort
+     * (matches the sync code which ignored status return codes). */
+    (void)status;
+    fpi_ssm_next_state(ssm);
+}
+
+
+/* event_read callback : parses events for frame_ready / false_detect. */
+static void
+vfy_cb_evread_poll(GObject *src, GAsyncResult *res, gpointer ud)
+{
+    (void)src;
+    FpiSsm *ssm = (FpiSsm *)ud;
+    VerimarkVerifyCtx *ctx = fpi_ssm_get_data(ssm);
+    uint16_t status = 0;
+    uint8_t *payload = NULL;
+    size_t   payload_len = 0;
+    GError  *err = NULL;
+    if (!verimark_session_call_opcode_finish(res, &status, &payload,
+                                              &payload_len, &err)) {
+        /* Transport error during a poll : skip this round, try again. */
+        if (err) g_clear_error(&err);
+        ctx->poll_count++;
+        fpi_ssm_jump_to_state(ssm, VFY_S_POLL_WAIT);
+        return;
+    }
+    ctx->poll_count++;
+    gboolean frame_ready = FALSE;
+    gboolean false_detect_this_round = FALSE;
+    gboolean is_retry = (ctx->attempt > 1);
+
+    if (status == 0x0000 && payload && payload_len >= 4) {
+        /* Inline event-read parser (mirrors verimark_capture_event_read). */
+        uint16_t returned = (uint16_t)(payload[0] | (payload[1] << 8));
+        size_t to_decode = returned;
+        if (to_decode > VERIMARK_EVENT_MAX_RETURNED) to_decode = VERIMARK_EVENT_MAX_RETURNED;
+        if (payload_len < 4 + to_decode * 12) {
+            size_t avail = (payload_len > 4) ? (payload_len - 4) / 12 : 0;
+            if (avail < to_decode) to_decode = avail;
+        }
+        for (size_t i = 0; i < to_decode && !frame_ready; i++) {
+            const uint8_t *rec = payload + 4 + i * 12;
+            uint8_t  type = rec[0];
+            uint32_t val0 = (uint32_t)rec[4]
+                          | ((uint32_t)rec[5] << 8)
+                          | ((uint32_t)rec[6] << 16)
+                          | ((uint32_t)rec[7] << 24);
+            uint32_t val1 = (uint32_t)rec[8]
+                          | ((uint32_t)rec[9] << 8)
+                          | ((uint32_t)rec[10] << 16)
+                          | ((uint32_t)rec[11] << 24);
+            gboolean has_fr = (val0 | val1) & VERIMARK_EVENT_FRAME_READY_BIT;
+            gboolean is_warm_frame = (is_retry && type == 0x18 && !has_fr);
+            if (has_fr || is_warm_frame) {
+                frame_ready = TRUE;
+                break;
+            }
+            if (!is_retry && type == 0x18 && !has_fr)
+                false_detect_this_round = TRUE;
+        }
+    }
+    g_free(payload);
+
+    if (frame_ready) {
+        ctx->frame_ready_this_attempt = TRUE;
+        fpi_ssm_jump_to_state(ssm, VFY_S_CFG_SPARSE);
+        return;
+    }
+    if (false_detect_this_round && !is_retry) {
+        ctx->saw_false_detect = TRUE;
+        fpi_ssm_jump_to_state(ssm, VFY_S_CFG_SPARSE);
+        return;
+    }
+    /* No verdict this round → keep polling (until deadline). */
+    fpi_ssm_jump_to_state(ssm, VFY_S_POLL_WAIT);
+}
+
+
+/* 0x99 match callback : 0x0000 + >=16 B payload = MATCH. */
+static void
+vfy_cb_match(GObject *src, GAsyncResult *res, gpointer ud)
+{
+    (void)src;
+    FpiSsm *ssm = (FpiSsm *)ud;
+    VerimarkVerifyCtx *ctx = fpi_ssm_get_data(ssm);
+    uint16_t status = 0;
+    uint8_t *payload = NULL;
+    size_t   payload_len = 0;
+    GError  *err = NULL;
+    if (!verimark_session_call_opcode_finish(res, &status, &payload,
+                                              &payload_len, &err)) {
+        fpi_ssm_mark_failed(ssm, err);
+        return;
+    }
+    if (status == 0x0000 && payload && payload_len >= VERIMARK_STORAGE_TUID_LEN) {
+        ctx->matched = TRUE;
+        memcpy(ctx->matched_tuid, payload, VERIMARK_STORAGE_TUID_LEN);
+        fp_info("verify: positive verdict on attempt %d (%zu bytes)",
+                ctx->attempt, payload_len);
+    } else {
+        fp_dbg("verify: attempt %d no-match (status 0x%04x, %zu bytes)",
+               ctx->attempt, status, payload_len);
+    }
+    g_free(payload);
+    fpi_ssm_next_state(ssm);
+}
+
+
+/* 0xa0 02 resolve callback : stash storage_handle for the done cb. */
+static void
+vfy_cb_resolve(GObject *src, GAsyncResult *res, gpointer ud)
+{
+    (void)src;
+    FpiSsm *ssm = (FpiSsm *)ud;
+    VerimarkVerifyCtx *ctx = fpi_ssm_get_data(ssm);
+    uint16_t status = 0;
+    uint8_t *payload = NULL;
+    size_t   payload_len = 0;
+    GError  *err = NULL;
+    if (!verimark_session_call_opcode_finish(res, &status, &payload,
+                                              &payload_len, &err)) {
+        /* Resolver failure is non-fatal — we just trust the sensor verdict. */
+        if (err) g_clear_error(&err);
+        ctx->resolve_ok = FALSE;
+        fpi_ssm_next_state(ssm);
+        return;
+    }
+    ctx->resolve_status = status;
+    /* Storage_handle is at offset 18 of the 50-byte response payload. */
+    if (status == 0x0000 && payload
+        && payload_len >= 18 + VERIMARK_STORAGE_TUID_LEN) {
+        memcpy(ctx->resolved_handle, payload + 18, VERIMARK_STORAGE_TUID_LEN);
+        ctx->resolve_ok = TRUE;
+    }
+    g_free(payload);
+    fpi_ssm_next_state(ssm);
+}
+
+
+/* ---- Timer callbacks --------------------------------------------------- */
+
+static gboolean
+vfy_timer_drain_sleep_cb(gpointer ud)
+{
+    FpiSsm *ssm = (FpiSsm *)ud;
+    VerimarkVerifyCtx *ctx = fpi_ssm_get_data(ssm);
+    ctx->pending_timer_id = 0;
+    fpi_ssm_next_state(ssm);
+    return G_SOURCE_REMOVE;
 }
 
 
 static gboolean
-verimark_run_capture_match_pipeline(FpiDeviceVerimark *self,
-                              gboolean *out_frame_ready,
-                              gboolean *out_match,
-                              uint8_t out_matched_tuid[VERIMARK_STORAGE_TUID_LEN],
