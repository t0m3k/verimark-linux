diff --git a/libfprint/drivers/verimark/pairing.c b/libfprint/drivers/verimark/pairing.c
index e465272..70b23ac 100644
--- a/libfprint/drivers/verimark/pairing.c
+++ b/libfprint/drivers/verimark/pairing.c
@@ -10,7 +10,9 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <fcntl.h>
 #include <sys/stat.h>
+#include <unistd.h>
 
 
 /* TLV record header : 6 octets [tag:u16 LE][len:u16 LE][2 reserved]. */
@@ -47,10 +49,14 @@ bool verimark_pairing_parse_blob(const uint8_t *blob, size_t blob_len,
     bool got_tag1 = false, got_tag2 = false, got_tag3 = false;
 
     size_t off = 0;
-    while (off + TLV_HEADER_SIZE <= blob_len) {
+    while (off < blob_len) {
+        if (blob_len - off < TLV_HEADER_SIZE)
+            return false;
         uint16_t tag = read_le16(blob + off);
         uint16_t len = read_le16(blob + off + 2);
-        /* off+2..off+4 = length, off+4..off+6 = 2 reserved/pad octets */
+        uint16_t reserved = read_le16(blob + off + 4);
+        if (reserved != 0)
+            return false;
 
         /* Tag 0 + len 0 = sentinel/end-of-table for some Synaptics dumps. */
         if (tag == 0 && len == 0) {
@@ -65,17 +71,20 @@ bool verimark_pairing_parse_blob(const uint8_t *blob, size_t blob_len,
         switch (tag) {
             case 1:
                 if (len != 400) return false;
+                if (got_tag1) return false;
                 memcpy(out->client_cert, value, 400);
                 got_tag1 = true;
                 break;
             case 2:
                 if (len != 32) return false;
+                if (got_tag2) return false;
                 /* sub1 stores priv in little-endian, normalize to BE for crypto. */
                 reverse_bytes(out->client_priv_be, value, 32);
                 got_tag2 = true;
                 break;
             case 3: {
                 if (len != 400) return false;
+                if (got_tag3) return false;
                 /* Server pubkey : X at offset 0x04, Y at offset 0x48, in LE.
                  * Reconstruct uncompressed `04 || X_BE || Y_BE`. */
                 out->server_pub_uncompressed[0] = 0x04;
@@ -94,7 +103,7 @@ bool verimark_pairing_parse_blob(const uint8_t *blob, size_t blob_len,
         off += TLV_HEADER_SIZE + len;
     }
 
-    return got_tag1 && got_tag2 && got_tag3;
+    return off == blob_len && got_tag1 && got_tag2 && got_tag3;
 }
 
 
@@ -103,13 +112,30 @@ bool verimark_pairing_load_from_file(const char *path,
 {
     if (!path || !out) return false;
 
-    FILE *fp = fopen(path, "rb");
-    if (!fp) return false;
+    struct stat st;
+    if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode) ||
+        S_IMODE(st.st_mode) != 0600)
+        return false;
+
+    int fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    if (fd < 0) return false;
+    struct stat opened;
+    if (fstat(fd, &opened) != 0 || opened.st_dev != st.st_dev ||
+        opened.st_ino != st.st_ino || !S_ISREG(opened.st_mode) ||
+        S_IMODE(opened.st_mode) != 0600) {
+        close(fd);
+        return false;
+    }
+    FILE *fp = fdopen(fd, "rb");
+    if (!fp) {
+        close(fd);
+        return false;
+    }
 
     /* Get file size. */
     if (fseek(fp, 0, SEEK_END) != 0) { fclose(fp); return false; }
     long sz = ftell(fp);
-    if (sz < 0 || sz > (1L << 20)) {   /* sane upper bound 1 MiB */
+    if (sz <= 0 || sz > (1L << 20)) {   /* sane upper bound 1 MiB */
         fclose(fp);
         return false;
     }
@@ -128,7 +154,10 @@ bool verimark_pairing_load_from_file(const char *path,
         return false;
     }
 
+    memset(out, 0, sizeof(*out));
     bool ok = verimark_pairing_parse_blob(blob, (size_t)sz, out);
+    if (!ok)
+        verimark_pairing_data_zero(out);
 
     /* Wipe the heap copy. */
     volatile uint8_t *p = (volatile uint8_t *)blob;
diff --git a/libfprint/drivers/verimark/verimark.c b/libfprint/drivers/verimark/verimark.c
index 3bfc339..e9925e1 100644
--- a/libfprint/drivers/verimark/verimark.c
