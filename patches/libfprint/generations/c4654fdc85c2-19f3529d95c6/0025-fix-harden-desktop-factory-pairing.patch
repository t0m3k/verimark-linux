@@ -78,6 +80,7 @@ struct _FpiDeviceVerimark {
     FpiSsm  *task_ssm;
     gpointer verify_ctx;
     gpointer enroll_ctx;
+    gboolean pairing_pending;
 };
 
 G_DEFINE_TYPE(FpiDeviceVerimark, fpi_device_verimark, FP_TYPE_DEVICE)
@@ -93,6 +96,34 @@ static const FpIdEntry id_table[] = {
 
 /* ---- Internal helpers ---------------------------------------------------- */
 
+static gchar *
+verimark_safe_component(const gchar *value)
+{
+    GString *safe = g_string_new(NULL);
+
+    if (value != NULL) {
+        for (const gchar *p = value; *p != '\0'; p++) {
+            if (g_ascii_isalnum(*p) || *p == '.' || *p == '_' || *p == '-')
+                g_string_append_c(safe, *p);
+            else
+                g_string_append_c(safe, '_');
+        }
+    }
+    if (safe->len == 0)
+        g_string_assign(safe, "unknown");
+    return g_string_free(safe, FALSE);
+}
+
+static gchar *
+verimark_usb_fallback_id(GUsbDevice *usb)
+{
+    const gchar *platform_id = g_usb_device_get_platform_id(usb);
+    if (platform_id != NULL && *platform_id != '\0')
+        return verimark_safe_component(platform_id);
+    return g_strdup_printf("usb-%u-%u", g_usb_device_get_bus(usb),
+                           g_usb_device_get_address(usb));
+}
+
 /**
  * Send `[opcode]` in cleartext, read the response, parse `[status][payload]`.
  * Returns TRUE if status == 0x0000, FALSE otherwise. On success, the output
@@ -211,8 +242,14 @@ static void verimark_probe(FpDevice *device)
     if (self->dev_info_valid)
         verimark_format_serial(&self->dev_info, serial);
 
+    g_autofree gchar *device_id = NULL;
+    if (self->dev_info_valid)
+        device_id = verimark_safe_component(serial);
+    else
+        device_id = verimark_usb_fallback_id(usb);
+
     fpi_device_probe_complete(device,
-                              g_strdup(serial),
+                              g_steal_pointer(&device_id),
                               g_strdup("Kensington VeriMark DT"),
                               NULL);
 }
@@ -260,8 +297,9 @@ static gchar *find_sub1_path(FpiDeviceVerimark *self)
         }
     }
     if (iserial != NULL && iserial[0] != '\0') {
+        g_autofree gchar *safe_iserial = verimark_safe_component(iserial);
         gchar *user_p = g_strdup_printf("%s/verimark/sub1-%s.bin",
-                                         xdg_cfg, iserial);
+                                         xdg_cfg, safe_iserial);
         if (g_file_test(user_p, G_FILE_TEST_EXISTS)) return user_p;
         g_free(user_p);
     }
@@ -280,30 +318,13 @@ static gchar *find_sub1_path(FpiDeviceVerimark *self)
  * crypto, transport, sensor refusal) — caller falls back to cleartext
  * mode without a fatal error.
  *
- * GUARDED by either :
- *   - environment variable VERIMARK_ALLOW_BOOTSTRAP=1
- *   - marker file        /var/lib/fprint/verimark/.allow_bootstrap
- *
- * Bootstrap is DESTRUCTIVE (rewrites the sensor's pairing slot) so we
- * require explicit opt-in. Once a sub1 exists the marker can be
- * deleted ; the file is not read again.
+ * This function is called only from the explicit fprintd enroll action.
+ * Opening a device must remain non-mutating.
  */
 static gchar *
-verimark_try_bootstrap(FpiDeviceVerimark *self)
+verimark_enroll_bootstrap(FpiDeviceVerimark *self)
 {
-    const gchar *env = g_getenv("VERIMARK_ALLOW_BOOTSTRAP");
-    gboolean env_ok  = (env && g_strcmp0(env, "1") == 0);
-    gboolean file_ok = g_file_test("/var/lib/fprint/verimark/.allow_bootstrap",
-                                    G_FILE_TEST_EXISTS);
-    if (!env_ok && !file_ok) {
-        fp_dbg("verimark: bootstrap skipped — set "
-                "VERIMARK_ALLOW_BOOTSTRAP=1 or create "
-                "/var/lib/fprint/verimark/.allow_bootstrap to opt in");
-        return NULL;
-    }
-
-    fp_info("verimark: bootstrap ENABLED — running 0x93 DoPairBasic "
-            "(DESTRUCTIVE)");
+    fp_info("verimark: enroll pairing started (DESTRUCTIVE)");
 
     uint8_t sub1[VERIMARK_BOOTSTRAP_SUB1_SIZE];
     uint16_t status = 0xffff;
@@ -320,37 +341,51 @@ verimark_try_bootstrap(FpiDeviceVerimark *self)
         return NULL;
     }
 
-    /* Atomic write : tmp + rename. */
+    /* Create the private directory and publish the credential without
+     * following symlinks or replacing an existing pairing. */
     const gchar *system_dir = "/var/lib/fprint/verimark";
     if (g_mkdir_with_parents(system_dir, 0700) != 0) {
         fp_warn("verimark: bootstrap mkdir(%s) failed", system_dir);
         memset(sub1, 0, sizeof(sub1));
         return NULL;
     }
-    g_autofree gchar *tmp_path  = g_strdup_printf("%s/sub1.bin.tmp", system_dir);
+    g_chmod(system_dir, 0700);
+    g_autofree gchar *tmp_path = g_strdup_printf("%s/.sub1.%u.tmp",
+                                                   system_dir, getpid());
     g_autofree gchar *final_path = g_strdup_printf("%s/sub1.bin", system_dir);
-
-    GError *werr = NULL;
-    if (!g_file_set_contents(tmp_path, (const gchar *)sub1,
-                              VERIMARK_BOOTSTRAP_SUB1_SIZE, &werr)) {
-        fp_warn("verimark: bootstrap write %s failed: %s", tmp_path,
-                werr ? werr->message : "?");
-        if (werr) g_error_free(werr);
+    int fd = open(tmp_path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) {
+        fp_warn("verimark: bootstrap temporary file creation failed");
         memset(sub1, 0, sizeof(sub1));
         return NULL;
     }
-    g_chmod(tmp_path, 0600);
-    if (g_rename(tmp_path, final_path) != 0) {
-        fp_warn("verimark: bootstrap rename(%s → %s) failed",
-                tmp_path, final_path);
+    ssize_t written = 0;
+    while (written < VERIMARK_BOOTSTRAP_SUB1_SIZE) {
+        ssize_t n = write(fd, sub1 + written,
+                          VERIMARK_BOOTSTRAP_SUB1_SIZE - written);
+        if (n <= 0) {
+            close(fd);
+            unlink(tmp_path);
+            fp_warn("verimark: bootstrap write failed");
+            memset(sub1, 0, sizeof(sub1));
+            return NULL;
+        }
+        written += n;
+    }
+    gboolean synced = fsync(fd) == 0;
+    gboolean closed = close(fd) == 0;
+    gboolean published = synced && closed && link(tmp_path, final_path) == 0;
+    if (!published) {
+        if (!closed)
+            close(fd);
+        unlink(tmp_path);
+        fp_warn("verimark: bootstrap credential publication failed");
         memset(sub1, 0, sizeof(sub1));
         return NULL;
     }
+    unlink(tmp_path);
 
-    fp_info("verimark: bootstrap SUCCEEDED — sub1 written to %s "
-            "(1284 B). You can now `rm "
-            "/var/lib/fprint/verimark/.allow_bootstrap` to lock pairing.",
-            final_path);
+    fp_info("verimark: enroll pairing succeeded (1284 B)");
     memset(sub1, 0, sizeof(sub1));
     return g_strdup(final_path);
 }
@@ -397,12 +432,10 @@ static void verimark_open(FpDevice *device)
      * succeeds so probe-level introspection keeps working. */
     g_autofree gchar *sub1_path = find_sub1_path(self);
     if (!sub1_path) {
-        /* Factory-fresh sensor — try bootstrap (gated by env / marker). */
-        sub1_path = verimark_try_bootstrap(self);
-    }
-    if (!sub1_path) {
+        /* Factory-fresh pairing is initiated only by an explicit enroll. */
+        self->pairing_pending = TRUE;
         fp_warn("verimark: no sub1 found in /var/lib/fprint/verimark/ ; "
-                "device opens in cleartext-only mode (no TLS session)");
+                "enroll is required to pair this factory-fresh device");
         fpi_device_open_complete(device, NULL);
         return;
     }
@@ -2405,6 +2438,48 @@ verimark_run_enroll_ssm(FpDevice *device)
 static void verimark_enroll(FpDevice *device)
 {
     G_DEBUG_HERE();
+
+    FpiDeviceVerimark *self = FPI_DEVICE_VERIMARK(device);
+    if (self->pairing_pending) {
+        g_autofree gchar *sub1_path = verimark_enroll_bootstrap(self);
+        if (sub1_path == NULL) {
+            fpi_device_enroll_complete(
+                device, NULL,
+                g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                            "enroll pairing failed"));
+            return;
+        }
+
+        VerimarkPairingData pairing;
+        if (!verimark_pairing_load_from_file(sub1_path, &pairing)) {
+            fpi_device_enroll_complete(
+                device, NULL,
+                g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                            "enroll pairing credential could not be loaded"));
+            return;
+        }
+
+        VerimarkTransportIoCtx io_ctx = {
+            .h = self->transport,
+            .timeout_ms = 3000,
+        };
+        VerimarkTransportIO io;
+        verimark_transport_io_bind(&io, &io_ctx);
+        VerimarkHandshakeResult hr = verimark_handshake_perform(
+            &io, &pairing, NULL, &self->session);
+        verimark_pairing_data_zero(&pairing);
+        if (hr != VERIMARK_HANDSHAKE_OK) {
+            verimark_session_zero(&self->session);
+            fpi_device_enroll_complete(
+                device, NULL,
+                g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "enroll pairing handshake failed"));
+            return;
+        }
+        self->session_active = TRUE;
+        self->pairing_pending = FALSE;
+    }
+
     /* Phase 10.3.e : delegate to the shared async enroll SSM. */
     verimark_run_enroll_ssm(device);
 }
