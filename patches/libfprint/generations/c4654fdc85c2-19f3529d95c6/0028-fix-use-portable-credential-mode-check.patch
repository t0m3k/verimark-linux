From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomasz Tracz <t@t90.dev>
Date: Wed, 19 Aug 2026 08:51:53 +0100
Subject: [PATCH 28/31] fix: use portable credential mode check

---
 libfprint/drivers/verimark/pairing.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libfprint/drivers/verimark/pairing.c b/libfprint/drivers/verimark/pairing.c
index 70b23ac..a4b63fa 100644
--- a/libfprint/drivers/verimark/pairing.c
+++ b/libfprint/drivers/verimark/pairing.c
@@ -114,7 +114,7 @@ bool verimark_pairing_load_from_file(const char *path,
 
     struct stat st;
     if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode) ||
-        S_IMODE(st.st_mode) != 0600)
+        (st.st_mode & 0777) != 0600)
         return false;
 
     int fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
@@ -122,7 +122,7 @@ bool verimark_pairing_load_from_file(const char *path,
     struct stat opened;
     if (fstat(fd, &opened) != 0 || opened.st_dev != st.st_dev ||
         opened.st_ino != st.st_ino || !S_ISREG(opened.st_mode) ||
-        S_IMODE(opened.st_mode) != 0600) {
+        (opened.st_mode & 0777) != 0600) {
         close(fd);
         return false;
     }
