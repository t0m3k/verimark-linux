@@ -112,6 +112,73 @@ extern const uint8_t VERIMARK_IT_INIT_19[1];
 #define VERIMARK_IT_HS_PREFIX_SIZE  4
 extern const uint8_t VERIMARK_IT_HS_PREFIX[VERIMARK_IT_HS_PREFIX_SIZE];
 
+/* ---- IT enroll commit (0x96 03) record + payload --------------------- *
+ *
+ * The IT firmware expects the 0x96 03 commit body to be a 443-byte
+ * structured record containing TUID + WINBIO SID identity + an opaque
+ * DPAPI blob, NOT a bare TUID. Wire framing on the cleartext side of
+ * the TLS session :
+ *
+ *   off 0   : 0x96                opcode
+ *   off 1   : 03 00 00 00         sub-cmd = 3 (u32 LE)
+ *   off 5   : 00 00 00 00         field0 = 0 (constant)
+ *   off 9   : LL LL LL LL         field1 = record length (u32 LE = 443)
+ *   off 13  : <record, 443 bytes>
+ *
+ * See docs/it-enroll-commit-decode.md for the full layout. The Python
+ * tools/verimark-it/enroll_commit.py is the cross-reference
+ * implementation (27/27 TDD tests). The DPAPI blob is opaque
+ * firmware-side ; the hypothesis is that zeros work for the
+ * match-on-chip path. */
+
+#define VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN  443
+#define VERIMARK_IT_ENROLL_COMMIT_PAYLOAD_LEN 455  /* 12 + 443 */
+#define VERIMARK_IT_ENROLL_SID_LEN            28
+#define VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN     326
+
+/* Synthetic SID for Linux callers : S-1-5-21-1-1-1-1000. The IT
+ * firmware does not validate SID semantics, only the structure. */
+extern const uint8_t VERIMARK_IT_ENROLL_SYNTHETIC_SID[VERIMARK_IT_ENROLL_SID_LEN];
+
+/**
+ * Build the 443-byte commit record at the start of `out`.
+ *
+ * @param tuid       16-byte template unique id.
+ * @param sid_or_null  28-byte SID (NULL → uses VERIMARK_IT_ENROLL_SYNTHETIC_SID).
+ * @param counter    u16 — enroll index. Windows increments per enroll
+ *                   (0x3F5, 0x3F6, ...). 0 is fine on Linux.
+ * @param dpapi_blob_or_null  326 bytes opaque blob (NULL → zeros).
+ * @param[out] out   Caller-allocated buffer.
+ * @param out_size   `out` capacity. Must be >= VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN.
+ *
+ * @return VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN on success, 0 on error.
+ */
+size_t verimark_it_build_enroll_commit_record(
+    const uint8_t tuid[16],
+    const uint8_t *sid_or_null,
+    uint16_t counter,
+    const uint8_t *dpapi_blob_or_null,
+    uint8_t *out, size_t out_size);
+
+/**
+ * Build the 455-byte payload to pass to verimark_session_call_opcode
+ * with opcode = 0x96. The opcode byte itself is added by the transport
+ * layer, so this payload starts at offset 1 of the wire frame :
+ *
+ *   [sub-cmd u32 LE = 03 00 00 00]
+ *   [field0  u32 LE = 00 00 00 00]
+ *   [field1  u32 LE = 443]
+ *   [443-byte record]
+ *
+ * @return VERIMARK_IT_ENROLL_COMMIT_PAYLOAD_LEN on success, 0 on error.
+ */
+size_t verimark_it_build_enroll_commit_payload(
+    const uint8_t tuid[16],
+    const uint8_t *sid_or_null,
+    uint16_t counter,
+    const uint8_t *dpapi_blob_or_null,
+    uint8_t *out, size_t out_size);
+
 /* ---- Helpers ---- */
 
 /**
