+TEST(payload_starts_with_sub_cmd_u32_le_3)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_payload(SAMPLE_TUID_2, NULL, 0, NULL,
+                                             out, sizeof(out));
+    static const uint8_t expected[4] = { 0x03, 0x00, 0x00, 0x00 };
+    ASSERT_MEM_EQ(out + 0, expected, 4);
+    return 0;
+}
+
+TEST(payload_field0_at_offset_4_is_zero)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_payload(SAMPLE_TUID_2, NULL, 0, NULL,
+                                             out, sizeof(out));
+    static const uint8_t expected[4] = { 0x00, 0x00, 0x00, 0x00 };
+    ASSERT_MEM_EQ(out + 4, expected, 4);
+    return 0;
+}
+
+TEST(payload_field1_at_offset_8_is_record_length_443_le)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_payload(SAMPLE_TUID_2, NULL, 0, NULL,
+                                             out, sizeof(out));
+    /* 443 = 0x1BB → LE = BB 01 00 00 */
+    static const uint8_t expected[4] = { 0xbb, 0x01, 0x00, 0x00 };
+    ASSERT_MEM_EQ(out + 8, expected, 4);
+    return 0;
+}
+
+
+/* ---- Record header and TUID section ---- */
+
+TEST(record_starts_with_version_word_zero)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
