+                                            out, sizeof(out));
+    ASSERT_EQ(out[0x06E], 0x00);
+    ASSERT_EQ(out[0x06F], 0x00);
+    return 0;
+}
+
+TEST(record_counter_u16_le_encoding)
+{
+    /* Windows sample #2 counter was 0x3F6. */
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0x3F6, NULL,
+                                            out, sizeof(out));
+    /* LE = f6 03 */
+    ASSERT_EQ(out[0x06E], 0xf6);
+    ASSERT_EQ(out[0x06F], 0x03);
+    return 0;
+}
+
+TEST(record_flag_at_0x070_is_zero)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                            out, sizeof(out));
+    ASSERT_EQ(out[0x070], 0x00);
+    return 0;
+}
+
+TEST(record_blob_length_at_0x071_is_u32_le_326)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                            out, sizeof(out));
+    /* 326 = 0x146 → LE 46 01 00 00 */
+    static const uint8_t expected[4] = { 0x46, 0x01, 0x00, 0x00 };
+    ASSERT_MEM_EQ(out + 0x071, expected, 4);
+    return 0;
+}
+
+
+/* ---- DPAPI blob ---- */
+
+TEST(record_default_blob_is_326_zeros)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                            out, sizeof(out));
+    for (size_t i = 0; i < VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN; i++) {
+        ASSERT_EQ(out[0x075 + i], 0x00);
+    }
+    return 0;
+}
+
+TEST(record_custom_blob_is_copied_verbatim)
+{
+    uint8_t blob[VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN];
+    for (size_t i = 0; i < sizeof(blob); i++)
+        blob[i] = (uint8_t)((i ^ 0xAA) & 0xFF);
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, blob,
+                                            out, sizeof(out));
+    ASSERT_MEM_EQ(out + 0x075, blob, VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN);
+    return 0;
+}
+
+
+/* ---- Boundaries ---- */
+
+TEST(record_ends_exactly_at_offset_0x1bb)
+{
+    uint8_t out[1024];
+    /* Sentinel byte after the record area. */
+    memset(out, 0xa5, sizeof(out));
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                            out, sizeof(out));
+    /* The last record byte is at offset 0x1BA = 442 (record_len = 443).
+     * Byte at 0x1BB must still be 0xa5 (untouched). */
+    ASSERT_EQ(out[0x1BA], 0x00);  /* last byte of the blob → zero */
+    ASSERT_EQ(out[0x1BB], 0xa5);  /* sentinel intact */
+    return 0;
+}
+
+
+/* ---- Error handling ---- */
+
+TEST(rejects_null_tuid)
+{
+    uint8_t out[1024];
+    ASSERT_EQ(verimark_it_build_enroll_commit_record(NULL, NULL, 0, NULL,
+                                                     out, sizeof(out)), 0);
+    ASSERT_EQ(verimark_it_build_enroll_commit_payload(NULL, NULL, 0, NULL,
+                                                      out, sizeof(out)), 0);
+    return 0;
+}
+
+TEST(rejects_null_output)
+{
+    ASSERT_EQ(verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                                     NULL, 1024), 0);
+    ASSERT_EQ(verimark_it_build_enroll_commit_payload(SAMPLE_TUID_2, NULL, 0, NULL,
+                                                      NULL, 1024), 0);
+    return 0;
+}
+
+TEST(rejects_undersized_output)
+{
+    uint8_t small[442];
+    ASSERT_EQ(verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
+                                                     small, sizeof(small)), 0);
+    uint8_t small_payload[454];
+    ASSERT_EQ(verimark_it_build_enroll_commit_payload(SAMPLE_TUID_2, NULL, 0, NULL,
+                                                      small_payload,
+                                                      sizeof(small_payload)), 0);
+    return 0;
+}
+
+
+typedef int (*test_fn)(void);
+
+struct test_entry {
+    const char *name;
+    test_fn     fn;
+};
+
+#define ADD_TEST(name) { #name, test_##name }
+
+int main(void)
+{
+    struct test_entry tests[] = {
+        ADD_TEST(record_length_is_443),
+        ADD_TEST(payload_length_is_455),
+        ADD_TEST(payload_starts_with_sub_cmd_u32_le_3),
+        ADD_TEST(payload_field0_at_offset_4_is_zero),
+        ADD_TEST(payload_field1_at_offset_8_is_record_length_443_le),
+        ADD_TEST(record_starts_with_version_word_zero),
+        ADD_TEST(record_tuid_length_at_0x002_is_u32_le_16),
+        ADD_TEST(record_tuid_at_0x006_matches_input),
+        ADD_TEST(record_identity_tag_at_0x016_is_u16_le_1),
+        ADD_TEST(record_identity_section_length_at_0x018_is_u32_le_76),
+        ADD_TEST(record_winbio_identity_type_at_0x01c_is_u32_le_3_sid),
+        ADD_TEST(record_sid_length_at_0x020_is_u32_le_28),
+        ADD_TEST(record_default_sid_is_synthetic_s_1_5_21),
+        ADD_TEST(record_custom_sid_is_inserted_verbatim),
+        ADD_TEST(record_sid_pad_at_0x040_is_40_zero_bytes),
+        ADD_TEST(record_data_tag_at_0x068_is_u16_le_2),
+        ADD_TEST(record_count_at_0x06a_is_u32_le_1),
+        ADD_TEST(record_default_counter_is_zero),
+        ADD_TEST(record_counter_u16_le_encoding),
+        ADD_TEST(record_flag_at_0x070_is_zero),
+        ADD_TEST(record_blob_length_at_0x071_is_u32_le_326),
+        ADD_TEST(record_default_blob_is_326_zeros),
+        ADD_TEST(record_custom_blob_is_copied_verbatim),
+        ADD_TEST(record_ends_exactly_at_offset_0x1bb),
+        ADD_TEST(rejects_null_tuid),
+        ADD_TEST(rejects_null_output),
+        ADD_TEST(rejects_undersized_output),
+    };
+    const size_t n = sizeof(tests) / sizeof(tests[0]);
+    int failed = 0;
+    for (size_t i = 0; i < n; i++) {
+        int r = tests[i].fn();
+        if (r != 0) {
+            fprintf(stderr, "FAIL %s\n", tests[i].name);
+            failed++;
+        } else {
+            fprintf(stdout, "ok   %s\n", tests[i].name);
+        }
+    }
+    fprintf(stdout, "\n%zu tests, %d failures\n", n, failed);
+    return failed == 0 ? 0 : 1;
+}
