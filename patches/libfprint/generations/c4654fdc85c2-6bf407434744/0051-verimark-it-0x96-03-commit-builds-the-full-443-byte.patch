+    ASSERT_MEM_EQ(out + 0x002, expected, 4);
+    return 0;
+}
+
+TEST(record_tuid_at_0x006_matches_input)
+{
+    uint8_t out[1024];
+    verimark_it_build_enroll_commit_record(SAMPLE_TUID_2, NULL, 0, NULL,
