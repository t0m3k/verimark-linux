+/* --- IT enroll commit (0x96 03) -------------------------------------- */
+
+/* Synthetic SID S-1-5-21-1-1-1-1000 (revision 1, NT authority,
+ * 5 sub-authorities = 21, 1, 1, 1, 1000). 28 bytes total. */
+const uint8_t VERIMARK_IT_ENROLL_SYNTHETIC_SID[VERIMARK_IT_ENROLL_SID_LEN] = {
+    0x01,                                /* Revision */
+    0x05,                                /* SubAuthorityCount */
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x05,  /* IdentifierAuthority = NT */
+    0x15, 0x00, 0x00, 0x00,              /* sub-auth 0 = 21 */
+    0x01, 0x00, 0x00, 0x00,              /* sub-auth 1 */
+    0x01, 0x00, 0x00, 0x00,              /* sub-auth 2 */
+    0x01, 0x00, 0x00, 0x00,              /* sub-auth 3 */
+    0xE8, 0x03, 0x00, 0x00,              /* sub-auth 4 = 1000 */
+};
+
+
+/* Small u16/u32 little-endian writers, kept local to avoid pulling in
+ * a host endianness dependency for what's a handful of fields. */
+static inline void wr_u16_le(uint8_t *p, uint16_t v)
+{
+    p[0] = (uint8_t)(v       & 0xff);
+    p[1] = (uint8_t)((v >> 8) & 0xff);
+}
+static inline void wr_u32_le(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)(v        & 0xff);
+    p[1] = (uint8_t)((v >>  8) & 0xff);
+    p[2] = (uint8_t)((v >> 16) & 0xff);
+    p[3] = (uint8_t)((v >> 24) & 0xff);
+}
+
+
+size_t verimark_it_build_enroll_commit_record(
+    const uint8_t tuid[16],
+    const uint8_t *sid_or_null,
+    uint16_t counter,
+    const uint8_t *dpapi_blob_or_null,
+    uint8_t *out, size_t out_size)
+{
+    if (tuid == NULL || out == NULL)
+        return 0;
+    if (out_size < VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN)
+        return 0;
+
+    const uint8_t *sid  = sid_or_null  ? sid_or_null  : VERIMARK_IT_ENROLL_SYNTHETIC_SID;
+    /* Cross-reference :
+     *   docs/it-enroll-commit-decode.md § "Structure du record"
+     *   tools/verimark-it/enroll_commit.py
+     *   tests/test_it_enroll_commit.py (Python TDD, 27/27)
+     *   driver/verimark/tests/test_it_enroll_commit.c (C TDD)         */
+    memset(out, 0, VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN);
+    /* 0x000 u16 LE = 0x0000 (record version) — already zero */
+    /* 0x002 u32 LE TUID length = 16 */
+    wr_u32_le(out + 0x002, 16);
+    /* 0x006 [16] TUID */
+    memcpy(out + 0x006, tuid, 16);
+    /* 0x016 u16 LE = 0x0001 (identity section tag) */
+    wr_u16_le(out + 0x016, 0x0001);
+    /* 0x018 u32 LE identity section length = 76 */
+    wr_u32_le(out + 0x018, 76);
+    /* 0x01C u32 LE WINBIO identity type = 3 (SID) */
+    wr_u32_le(out + 0x01C, 3);
+    /* 0x020 u32 LE SID length = 28 */
+    wr_u32_le(out + 0x020, 28);
+    /* 0x024 [28] SID */
+    memcpy(out + 0x024, sid, 28);
+    /* 0x040..0x067 [40] pad zeros — already zero */
+    /* 0x068 u16 LE = 0x0002 (data section tag) */
+    wr_u16_le(out + 0x068, 0x0002);
+    /* 0x06A u32 LE = 0x01 (count) */
+    wr_u32_le(out + 0x06A, 1);
+    /* 0x06E u16 LE counter */
+    wr_u16_le(out + 0x06E, counter);
+    /* 0x070 u8 flag = 0x00 — already zero */
+    /* 0x071 u32 LE blob length = 326 */
+    wr_u32_le(out + 0x071, VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN);
+    /* 0x075 [326] DPAPI blob — zeros by default */
+    if (dpapi_blob_or_null != NULL) {
+        memcpy(out + 0x075, dpapi_blob_or_null,
+               VERIMARK_IT_ENROLL_DPAPI_BLOB_LEN);
+    }
+    return VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN;
+}
+
+
+size_t verimark_it_build_enroll_commit_payload(
+    const uint8_t tuid[16],
+    const uint8_t *sid_or_null,
+    uint16_t counter,
+    const uint8_t *dpapi_blob_or_null,
+    uint8_t *out, size_t out_size)
+{
+    if (tuid == NULL || out == NULL)
+        return 0;
+    if (out_size < VERIMARK_IT_ENROLL_COMMIT_PAYLOAD_LEN)
+        return 0;
+
+    /* [sub-cmd u32 LE = 3][field0 u32 LE = 0][field1 u32 LE = 443] */
+    wr_u32_le(out + 0, 3);
+    wr_u32_le(out + 4, 0);
+    wr_u32_le(out + 8, VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN);
+
+    size_t n = verimark_it_build_enroll_commit_record(
+        tuid, sid_or_null, counter, dpapi_blob_or_null,
+        out + 12, out_size - 12);
+    if (n != VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN)
+        return 0;
+    return VERIMARK_IT_ENROLL_COMMIT_PAYLOAD_LEN;
+}
+
+
 uint16_t verimark_compute_wvalue_write(size_t original_length)
 {
     /* wValue = original_length & magic_write & 7 = original_length & 7
