+/* Sample TUID from the 2026-06-07 cdb capture (right index, sample #2). */
+static const uint8_t SAMPLE_TUID_2[16] = {
+    0xd9, 0x92, 0xaa, 0x60, 0x4b, 0xc1, 0xba, 0x8c,
+    0xed, 0xe8, 0x53, 0xd0, 0x64, 0x67, 0x5c, 0xcc,
+};
+
+
+/* ---- Lengths ---- */
+
+TEST(record_length_is_443)
+{
+    uint8_t out[1024];
+    size_t n = verimark_it_build_enroll_commit_record(
+        SAMPLE_TUID_2, NULL, 0, NULL, out, sizeof(out));
+    ASSERT_EQ(n, VERIMARK_IT_ENROLL_COMMIT_RECORD_LEN);
+    ASSERT_EQ(n, 443);
+    return 0;
+}
+
+TEST(payload_length_is_455)
+{
+    uint8_t out[1024];
+    size_t n = verimark_it_build_enroll_commit_payload(
+        SAMPLE_TUID_2, NULL, 0, NULL, out, sizeof(out));
+    ASSERT_EQ(n, VERIMARK_IT_ENROLL_COMMIT_PAYLOAD_LEN);
+    ASSERT_EQ(n, 12 + 443);
+    return 0;
+}
+
+
+/* ---- Wire framing header (the 12 bytes before the record) ---- */
