+/* ---- ctx free ---------------------------------------------------------- */
+
+static void
+enroll_ctx_free(gpointer data)
+{
+    VerimarkEnrollCtx *ctx = data;
+    if (ctx == NULL) return;
+    if (ctx->pending_timer_id != 0) {
+        g_source_remove(ctx->pending_timer_id);
+        ctx->pending_timer_id = 0;
+    }
+    if (ctx->fatal_error)
+        g_error_free(ctx->fatal_error);
+    g_free(ctx);
+}
