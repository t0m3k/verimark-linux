+    VerimarkEnrollCtx *ctx = g_new0(VerimarkEnrollCtx, 1);
+    ctx->attempt = 1;
+
+    self->task_ssm = fpi_ssm_new(device, enroll_sm_run_state, ENR_S_LAST);
+    fpi_ssm_set_data(self->task_ssm, ctx, enroll_ctx_free);
+    self->enroll_ctx = ctx;
+    fpi_ssm_start(self->task_ssm, enroll_sm_done);
+}
+
+
+static void verimark_enroll(FpDevice *device)
+{
+    G_DEBUG_HERE();
+    /* Phase 10.3.e : delegate to the shared async enroll SSM. */
+    verimark_run_enroll_ssm(device);
