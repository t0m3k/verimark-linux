-    fp_dbg("verify: [preamble] 0x86 events_1_2    status=0x%04x", st);
-
-    VerimarkEventReadResult ev = {0};
     verimark_capture_event_read(&self->session, &io, 0, 32, &ev, &st);
-    fp_dbg("verify: [preamble] 0x87 cursor=0       status=0x%04x returned=%u total=%u",
-           st, ev.returned_count, ev.total_count);
-
     verimark_capture_event_config(&self->session, &io,
                                    NULL, NULL, /*field_21=*/4, &st);
-    fp_dbg("verify: [preamble] 0x86 subscribe_all  status=0x%04x", st);
 
-    /* === Capture (single attempt for v1) === */
-    if (!verimark_capture_config(&self->session, &io, VERIMARK_CFG_RICH, &st)) {
-        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
-                               "verify: 0x39 RICH transport failure");
-        return FALSE;
-    }
-    fp_dbg("verify: [capture]  0x39 RICH           status=0x%04x", st);
+    /* === Attempt loop ===
+     * Mirrors python verify main() flow : attempt 1 uses RICH (strict
+     * pre-filter, high quality required) ; attempts 2..N flip the
+     * firmware into "WARM mode" by emitting `0x39 WARM` before
+     * RICH — that loosens the pre-filter so marginal touches get
+     * accepted, AND any type=0x18 event qualifies as frame_ready
+     * (not just ones with the 0x1000 bit). Up to 3 attempts total. */
+    int attempt = 0;
+    int last_poll_count = 0;
+    for (attempt = 1; attempt <= VERIMARK_VERIFY_MAX_ATTEMPTS; attempt++) {
+        gboolean is_retry = (attempt > 1);
 
-    verimark_capture_event_config(&self->session, &io,
-                                   VERIMARK_MASK_FRAME_READY_ARM,
-                                   VERIMARK_MASK_FRAME_READY_ARM, 0, &st);
-    fp_dbg("verify: [capture]  0x86 frame_ready    status=0x%04x", st);
+        /* Inter-attempt drain (cursor-based, per python). */
+        if (is_retry) {
+            uint16_t cursor_a = (uint16_t)(2 + (attempt - 2) * 4);
+            uint16_t cursor_b = (uint16_t)(cursor_a + 2);
+            verimark_verify_drain_between_attempts(self, &io,
+                                                    cursor_a, cursor_b);
+            g_usleep(500 * 1000);   /* 0.5 s — let user lift finger */
+        }
 
-    /* Surface the "place finger" cue at INFO level too — the
-     * debug-only fp_dbg() wouldn't reach a user running fprintd or
-     * fp_device_verify_sync without G_MESSAGES_DEBUG. */
-    fp_warn("verify: PLACE YOUR FINGER ON THE SENSOR NOW (timeout %d s)",
-            VERIMARK_VERIFY_TIMEOUT_S);
-    g_print(">>> PLACE YOUR FINGER ON THE SENSOR NOW <<< (timeout %d s)\n",
-            VERIMARK_VERIFY_TIMEOUT_S);
+        /* WARM-mode kickoff (only on retries) — loosens on-chip
+         * pre-filter and primes the matcher's retry path. */
+        if (is_retry) {
+            verimark_capture_config(&self->session, &io,
+                                     VERIMARK_CFG_WARM, &st);
+        }
+        verimark_capture_config(&self->session, &io, VERIMARK_CFG_RICH, &st);
+        verimark_capture_event_config(&self->session, &io,
+                                       VERIMARK_MASK_FRAME_READY_ARM,
+                                       VERIMARK_MASK_FRAME_READY_ARM, 0, &st);
 
-    if (!verimark_capture_start(&self->session, &io,
-                                 VERIMARK_CAPSTART_VERIFY, &st)) {
-        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
-                               "verify: 0x80 capture_start transport failure");
-        return FALSE;
-    }
+        if (attempt == 1) {
+            fp_warn("verify: attempt %d/%d — PLACE YOUR FINGER (timeout %d s)",
+                    attempt, VERIMARK_VERIFY_MAX_ATTEMPTS,
+                    VERIMARK_VERIFY_TIMEOUT_S);
+            g_print(">>> PLACE YOUR FINGER ON THE SENSOR NOW <<< (timeout %d s)\n",
+                    VERIMARK_VERIFY_TIMEOUT_S);
+        } else {
+            fp_warn("verify: attempt %d/%d — RETRY (WARM mode, looser pre-filter)",
+                    attempt, VERIMARK_VERIFY_MAX_ATTEMPTS);
+            g_print(">>> RETRY — touch again (attempt %d/%d) <<<\n",
+                    attempt, VERIMARK_VERIFY_MAX_ATTEMPTS);
+        }
 
-    /* Polling loop for frame_ready. */
-    gint64 deadline_us = g_get_monotonic_time()
-                       + (gint64)VERIMARK_VERIFY_TIMEOUT_S * G_USEC_PER_SEC;
-    int poll_count = 0;
-    int last_logged_count = 0;
-    while (g_get_monotonic_time() < deadline_us) {
-        poll_count++;
-        VerimarkEventReadResult r = {0};
-        uint16_t poll_st = 0;
-        if (!verimark_capture_event_read(&self->session, &io, 0, 32, &r, &poll_st)) {
-            if (poll_count - last_logged_count >= 8) {
-                fp_dbg("verify: [poll #%d] 0x87 TRANSPORT FAIL", poll_count);
-                last_logged_count = poll_count;
+        if (!verimark_capture_start(&self->session, &io,
+                                     VERIMARK_CAPSTART_VERIFY, &st)) {
+            *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                                   "verify: 0x80 capture_start transport failure");
+            return FALSE;
+        }
+
+        /* Poll for FRAME_READY (or any type=0x18 in WARM mode).
+         * Track `saw_false_detect` : a type=0x18 event without the
+         * 0x1000 bit means the on-chip pre-filter REJECTED the touch.
+         * In RICH mode no further FRAME_READY will come for this
+         * attempt — exit the poll loop immediately and trigger retry. */
+        gint64 deadline_us = g_get_monotonic_time()
+                           + (gint64)VERIMARK_VERIFY_TIMEOUT_S * G_USEC_PER_SEC;
+        gboolean frame_ready_this_attempt = FALSE;
+        gboolean saw_false_detect = FALSE;
+        int poll_count = 0;
+        while (g_get_monotonic_time() < deadline_us) {
+            poll_count++;
+            VerimarkEventReadResult r = {0};
+            uint16_t poll_st = 0;
+            if (!verimark_capture_event_read(&self->session, &io,
+                                              0, 32, &r, &poll_st)) {
+                g_usleep(VERIMARK_VERIFY_POLL_INTERVAL_MS * 1000);
+                continue;
             }
+            for (size_t i = 0; i < r.returned_count && !frame_ready_this_attempt; i++) {
+                const VerimarkSensorEvent *e = &r.events[i];
+                gboolean has_fr_bit =
+                    (e->val0 | e->val1) & VERIMARK_EVENT_FRAME_READY_BIT;
+                gboolean is_warm_frame = (is_retry && e->type == 0x18
+                                          && !has_fr_bit);
+                if (has_fr_bit || is_warm_frame) {
+                    frame_ready_this_attempt = TRUE;
+                    break;
+                }
+                if (!is_retry && e->type == 0x18 && !has_fr_bit)
+                    saw_false_detect = TRUE;
+            }
+            if (frame_ready_this_attempt)
+                break;
+            /* Early exit on RICH-mode false-detect — no FRAME_READY
+             * will fire for this attempt, save the timeout wait. */
+            if (saw_false_detect && !is_retry)
+                break;
             g_usleep(VERIMARK_VERIFY_POLL_INTERVAL_MS * 1000);
-            continue;
         }
-        if (poll_st != 0x0000 && poll_count - last_logged_count >= 8) {
-            fp_dbg("verify: [poll #%d] 0x87 status=0x%04x total=%u",
-                   poll_count, poll_st, r.total_count);
-            last_logged_count = poll_count;
-        }
-        /* Always print every event we get — that's how we'll find the
