 libfprint/drivers/verimark/verimark.c | 275 ++++++++++++++++----------
 1 file changed, 167 insertions(+), 108 deletions(-)

diff --git a/libfprint/drivers/verimark/verimark.c b/libfprint/drivers/verimark/verimark.c
index c12ba772..2e9d27c7 100644
--- a/libfprint/drivers/verimark/verimark.c
+++ b/libfprint/drivers/verimark/verimark.c
@@ -430,6 +430,7 @@ static FpPrint *verimark_print_from_tuid(FpDevice *device,
 
 #define VERIMARK_VERIFY_POLL_INTERVAL_MS 250
 #define VERIMARK_VERIFY_TIMEOUT_S        30
+#define VERIMARK_VERIFY_MAX_ATTEMPTS     3
 
 
 /* Capture config templates — exact bytes from python/verimark/match.py
@@ -590,6 +591,33 @@ verimark_io_bind(FpiDeviceVerimark *self,
  * it back to the class-1 storage_handle that libfprint compares
  * against.
  */
+/**
+ * 7-opcode inter-attempt drain (between verify retries). Mirrors
+ * python `_inter_attempt_drain`. Cursors advance by 4 per drain.
+ */
+static void
+verimark_verify_drain_between_attempts(FpiDeviceVerimark *self,
+                                        VerimarkTransportIO *io,
+                                        uint16_t cursor_a, uint16_t cursor_b)
+{
+    uint16_t st = 0;
+    VerimarkEventReadResult ev = {0};
+    verimark_capture_config(&self->session, io, VERIMARK_CFG_WARM, &st);
+    verimark_capture_event_config(&self->session, io,
+                                   VERIMARK_MASK_EVENTS_1_AND_2,
+                                   VERIMARK_MASK_EVENTS_1_AND_2, 0, &st);
+    verimark_capture_event_read(&self->session, io, cursor_a, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, io,
+                                   NULL, NULL, /*field_21=*/4, &st);
+    verimark_capture_event_config(&self->session, io,
+                                   VERIMARK_MASK_EVENT_2,
+                                   VERIMARK_MASK_EVENT_2, 0, &st);
+    verimark_capture_event_read(&self->session, io, cursor_b, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, io,
+                                   NULL, NULL, /*field_21=*/4, &st);
+}
+
+
 static gboolean
 verimark_run_verify_pipeline(FpiDeviceVerimark *self,
                               gboolean *out_frame_ready,
@@ -608,142 +636,165 @@ verimark_run_verify_pipeline(FpiDeviceVerimark *self,
     verimark_io_bind(self, &io_ctx, &io);
 
     uint16_t st = 0;
+    VerimarkEventReadResult ev = {0};
 
-    /* === Preamble === */
+    /* === Preamble (once) === */
     if (!verimark_capture_init_session(&self->session, &io, &st)) {
