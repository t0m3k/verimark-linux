-        for (size_t i = 0; i < r.returned_count; i++) {
-            const VerimarkSensorEvent *e = &r.events[i];
-            fp_dbg("verify: [poll #%d] EVENT type=0x%02x val0=0x%08x val1=0x%08x",
-                   poll_count, e->type,
-                   (unsigned)e->val0, (unsigned)e->val1);
-        }
-        if (verimark_capture_events_have_frame_ready(&r, NULL)) {
-            fp_dbg("verify: FRAME_READY event after %d poll(s)", poll_count);
+        last_poll_count = poll_count;
+        fp_warn("verify: attempt %d poll done — frame_ready=%d polls=%d "
+                "false_detect=%d",
+                attempt, frame_ready_this_attempt, poll_count,
+                saw_false_detect);
+
+        /* Close the capture window for this attempt. */
+        verimark_capture_config(&self->session, &io, VERIMARK_CFG_SPARSE, &st);
+        verimark_capture_event_config(&self->session, &io,
+                                       NULL, NULL, /*field_21=*/4, &st);
+        verimark_capture_status_poll(&self->session, &io, &st, &st);
+
+        if (frame_ready_this_attempt && !*out_frame_ready)
             *out_frame_ready = TRUE;
+
+        if (!frame_ready_this_attempt) {
+            /* Either timeout or false-detect early exit — try again. */
+            if (attempt < VERIMARK_VERIFY_MAX_ATTEMPTS) {
+                fp_warn("verify: no frame_ready on attempt %d, retrying",
+                        attempt);
+                continue;
+            }
             break;
         }
-        g_usleep(VERIMARK_VERIFY_POLL_INTERVAL_MS * 1000);
-    }
-    fp_warn("verify: poll loop done — frame_ready=%d, polls=%d",
-            *out_frame_ready, poll_count);
 
-    /* Close the capture window regardless of frame_ready outcome. */
-    verimark_capture_config(&self->session, &io, VERIMARK_CFG_SPARSE, &st);
-    verimark_capture_event_config(&self->session, &io,
-                                   NULL, NULL, /*field_21=*/4, &st);
-    verimark_capture_status_poll(&self->session, &io, &st, &st);   /* 0x81 capture_stop */
+        /* Touch was accepted → run 0x99 match. */
+        VerimarkMatchVerdict v = {0};
+        uint16_t v_st = 0;
+        if (!verimark_match_simple(&self->session, &io, &v, &v_st)) {
+            *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                                   "verify: 0x99 match transport failure");
+            return FALSE;
+        }
+        if (v_st == 0x0000 && v.len >= 16) {
+            fp_warn("verify: positive verdict on attempt %d (%zu bytes)",
+                    attempt, v.len);
+            *out_match = TRUE;
+            if (out_matched_tuid)
+                memcpy(out_matched_tuid, v.bytes,
+                       VERIMARK_STORAGE_TUID_LEN);
+            break;   /* MATCH — done */
+        }
 
