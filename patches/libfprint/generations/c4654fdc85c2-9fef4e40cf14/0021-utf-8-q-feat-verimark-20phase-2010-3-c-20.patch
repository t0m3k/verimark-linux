+/* --- Async handshake (Phase 10.3.c, libgusb-only) ----------------------
+ *
+ * Non-blocking equivalent of verimark_handshake_perform. Drives the two
+ * USB round-trips (ClientHello → ServerHello ; Flight2 → ServerResponse)
+ * via verimark_transceive_async, performs the crypto on the GMainLoop
+ * thread (microseconds, not worth offloading), and fires `callback` once
+ * the whole handshake completes (success OR failure OR cancellation).
+ *
+ * The caller does NOT need to keep `pairing` alive after the function
+ * returns — the orchestrator deep-copies it into a heap-owned context.
+ * The copy is wiped before free.
+ *
+ * `timeout_ms` applies to BOTH the OUT and the IN transfer of EACH round-
+ * trip (= 4 individual timeouts max).
+ *
+ * `cancellable` may be NULL.
+ *
+ * No vtable abstraction here : the async path drives the USB handle
+ * directly via verimark_transceive_async (which knows the wValue formula
+ * and 8-byte alignment). The `44 00 00 00` handshake-mode prefix is
+ * prepended manually before each send.
+ */
+#ifdef VERIMARK_HAVE_LIBGUSB
+#include <gio/gio.h>
+
+typedef struct VerimarkUsbHandle VerimarkUsbHandle;
+
+void verimark_handshake_perform_async(
+    VerimarkUsbHandle *transport,
+    unsigned timeout_ms,
+    const VerimarkPairingData *pairing,
+    const VerimarkHandshakeReproducibleParams *repro_or_null,
+    GCancellable *cancellable,
+    GAsyncReadyCallback callback,
+    gpointer user_data);
+
+/**
+ * On success copies the derived AES-GCM session into `*session_out`
+ * (with sequence counters advanced to 1 on both sides, matching the
+ * sync path). Returns VERIMARK_HANDSHAKE_OK.
+ *
+ * On failure returns the matching VerimarkHandshakeResult code and
+ * populates `*error` (if non-NULL) with a descriptive GError. The
+ * caller's `*session_out` is left zeroed.
+ */
+VerimarkHandshakeResult verimark_handshake_perform_finish(
+    GAsyncResult *res,
+    VerimarkSession *session_out,
+    GError **error);
+
+#endif /* VERIMARK_HAVE_LIBGUSB */
+
