From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomasz Tracz <t@t90.dev>
Date: Wed, 19 Aug 2026 09:48:23 +0100
Subject: [PATCH 33/38] fix: make pairing publication dirfd-safe

---
 libfprint/drivers/verimark/pairing.c  |  4 ++--
 libfprint/drivers/verimark/verimark.c | 32 +++++++++++++++++++--------
 2 files changed, 25 insertions(+), 11 deletions(-)

diff --git a/libfprint/drivers/verimark/pairing.c b/libfprint/drivers/verimark/pairing.c
index 248c4f93..f5614222 100644
--- a/libfprint/drivers/verimark/pairing.c
+++ b/libfprint/drivers/verimark/pairing.c
@@ -118,7 +118,7 @@ bool verimark_pairing_load_from_file(const char *path,
 
     struct stat st;
     if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode) ||
-        (st.st_mode & 0777) != 0600)
+        (st.st_mode & 07777) != 0600)
         return false;
 
     int fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
@@ -126,7 +126,7 @@ bool verimark_pairing_load_from_file(const char *path,
     struct stat opened;
     if (fstat(fd, &opened) != 0 || opened.st_dev != st.st_dev ||
         opened.st_ino != st.st_ino || !S_ISREG(opened.st_mode) ||
-        (opened.st_mode & 0777) != 0600) {
+        (opened.st_mode & 07777) != 0600) {
         close(fd);
         return false;
     }
diff --git a/libfprint/drivers/verimark/verimark.c b/libfprint/drivers/verimark/verimark.c
index c53f6f06..396a7308 100644
--- a/libfprint/drivers/verimark/verimark.c
+++ b/libfprint/drivers/verimark/verimark.c
@@ -330,8 +330,8 @@ verimark_enroll_bootstrap(FpiDeviceVerimark *self)
         return NULL;
     }
 
-    /* Create the private directory and publish the credential without
-     * following symlinks or replacing an existing pairing. */
+    /* Create the private directory and publish the credential relative to a
+     * no-follow directory fd, without replacing an existing pairing. */
     const gchar *system_dir = "/var/lib/fprint/verimark";
     if (g_mkdir_with_parents(system_dir, 0700) != 0) {
         fp_warn("verimark: bootstrap mkdir(%s) failed", system_dir);
@@ -339,11 +339,20 @@ verimark_enroll_bootstrap(FpiDeviceVerimark *self)
         return NULL;
     }
     g_chmod(system_dir, 0700);
-    g_autofree gchar *tmp_path = g_strdup_printf("%s/.sub1.%u.tmp",
-                                                   system_dir, getpid());
+    int dir_fd = open(system_dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (dir_fd < 0) {
+        fp_warn("verimark: bootstrap directory is not safe");
+        memset(sub1, 0, sizeof(sub1));
+        return NULL;
+    }
+    char tmp_name[64];
+    g_snprintf(tmp_name, sizeof(tmp_name), ".sub1.%u.tmp", getpid());
     g_autofree gchar *final_path = g_strdup_printf("%s/sub1.bin", system_dir);
-    int fd = open(tmp_path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    int fd = openat(dir_fd, tmp_name,
+                    O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+                    0600);
     if (fd < 0) {
+        close(dir_fd);
         fp_warn("verimark: bootstrap temporary file creation failed");
         memset(sub1, 0, sizeof(sub1));
         return NULL;
@@ -354,7 +363,8 @@ verimark_enroll_bootstrap(FpiDeviceVerimark *self)
                           VERIMARK_BOOTSTRAP_SUB1_SIZE - written);
         if (n <= 0) {
             close(fd);
-            unlink(tmp_path);
+            unlinkat(dir_fd, tmp_name, 0);
+            close(dir_fd);
             fp_warn("verimark: bootstrap write failed");
             memset(sub1, 0, sizeof(sub1));
             return NULL;
@@ -363,16 +373,20 @@ verimark_enroll_bootstrap(FpiDeviceVerimark *self)
     }
     gboolean synced = fsync(fd) == 0;
     gboolean closed = close(fd) == 0;
-    gboolean published = synced && closed && link(tmp_path, final_path) == 0;
+    gboolean published = synced && closed &&
+                        linkat(dir_fd, tmp_name, dir_fd, "sub1.bin", 0) == 0;
     if (!published) {
         if (!closed)
             close(fd);
-        unlink(tmp_path);
+        unlinkat(dir_fd, tmp_name, 0);
+        close(dir_fd);
         fp_warn("verimark: bootstrap credential publication failed");
         memset(sub1, 0, sizeof(sub1));
         return NULL;
     }
-    unlink(tmp_path);
+    unlinkat(dir_fd, tmp_name, 0);
+    fsync(dir_fd);
+    close(dir_fd);
 
     fp_info("verimark: enroll pairing succeeded (1284 B)");
     memset(sub1, 0, sizeof(sub1));
