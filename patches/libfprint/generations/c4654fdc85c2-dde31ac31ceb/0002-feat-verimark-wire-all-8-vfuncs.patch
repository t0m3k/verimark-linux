+    } else {
+        fp_dbg("verify: no-match (status 0x%04x, %zu bytes)", st, v.len);
+        /* Fire 0x39 WARM to trigger the firmware's brief red-LED
+         * "no-match" feedback (cf. docs/phase9-led-red-finding.md).
+         * Even without a retry loop, this gives the user the visual
+         * cue that the touch was seen and rejected. */
+        verimark_capture_config(&self->session, &io, VERIMARK_CFG_WARM, &st);
+        fp_dbg("verify: [no-match] 0x39 WARM        status=0x%04x (red-LED feedback)", st);
+    }
+
+    /* === Postamble (best-effort cleanup) === */
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_MIXED, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   VERIMARK_MASK_EVENTS_1_AND_2,
+                                   VERIMARK_MASK_EVENTS_1_AND_2, 0, &st);
+    verimark_capture_event_read(&self->session, &io, 2, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   NULL, NULL, /*field_21=*/4, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   VERIMARK_MASK_EVENT_2,
+                                   VERIMARK_MASK_EVENT_2, 0, &st);
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_SPARSE, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   NULL, NULL, /*field_21=*/4, &st);
+
+    return *out_match;
+}
