+/* ---- enroll pipeline -----------------------------------------------------
+ *
+ * Canonical Linux enroll flow (cf. `python/verimark/enroll.py`) :
+ *
+ *   prelude    : 0x86 / 0x87 / 0x86 / 0x39 RICH / 0x86 / 0x80 verify-mode /
+ *                0x87 / 0x39 SPARSE / 0x86 / 0x81 / 0x99 / 0x39 ENROLL_E
+ *   begin      : 0x96 01
+ *   per swipe  : 0x39 RICH / 0x86 frame_ready_arm / 0x80 ENROLL-mode /
+ *                poll 0x87 / 0x39 SPARSE / 0x86 / 0x81 / 0x96 02 add_image
+ *   commit     : 0x96 03 (random tuid + zero SID)
+ *   db refresh : 0x9e 01
+ *   finish     : 0x96 04
+ *
+ * The on-chip engine requires 7 UNIQUE swipes (bitmask grows
+ * 0x01→0x03→0x07→…→0x7f). Duplicate / low-quality swipes leave the
+ * bitmask unchanged ; we loop up to `MAX_SWIPES` attempts. If we
+ * never reach 0x7f, the commit refuses with 0x0404.
+ * ------------------------------------------------------------------------- */
+
+#define VERIMARK_ENROLL_MAX_SWIPES         12
+#define VERIMARK_ENROLL_SWIPE_TIMEOUT_S    30
+#define VERIMARK_ENROLL_TARGET_BITMASK_7F  0x7fu
+#define VERIMARK_ENROLL_PROGRESS_STAGES    7
+
+
+/**
+ * 6-opcode pre-cycle drain emitted before each swipe attempt. Mirrors
+ * python `_drain_pre_cycle` ; cursors advance per UNIQUE swipe.
+ */
+static void
+verimark_enroll_drain_pre_cycle(FpiDeviceVerimark *self,
+                                 VerimarkTransportIO *io,
+                                 uint16_t cursor_a, uint16_t cursor_b)
+{
+    uint16_t st = 0;
+    VerimarkEventReadResult ev = {0};
+    verimark_capture_event_config(&self->session, io,
+                                   VERIMARK_MASK_EVENTS_1_AND_2,
+                                   VERIMARK_MASK_EVENTS_1_AND_2, 0, &st);
+    verimark_capture_event_read(&self->session, io, cursor_a, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, io, NULL, NULL, 4, &st);
+    verimark_capture_event_config(&self->session, io,
+                                   VERIMARK_MASK_EVENT_2,
+                                   VERIMARK_MASK_EVENT_2, 0, &st);
+    verimark_capture_event_read(&self->session, io, cursor_b, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, io, NULL, NULL, 4, &st);
+}
+
+
+/**
+ * Per-swipe inner loop : run one full capture cycle and the
+ * subsequent `0x96 02 add_image` call. Returns TRUE if the cycle
+ * completed (regardless of accept / reject). On no-finger timeout,
+ * returns FALSE with `*out_timed_out = TRUE`.
+ *
+ * Matches python `one_capture_cycle` in full :
+ *   - 6-opcode pre-cycle drain (cursors advance per unique swipe)
+ *   - 0x39 WARM (loosen pre-filter)
+ *   - 0x39 D (first swipe init) or RICH (subsequent)
+ *   - 0x86 frame_ready_arm + 0x80 ENROLL-mode capture_start
+ *   - poll 0x87 with 0x39 RICH↔SPARSE keep-alive every 500 ms
+ *     (without this, the firmware disarms the FSM and the LED dies)
+ *   - 0x39 SPARSE + 0x86 subscribe_all + 0x81 cleanup
+ *   - 0x96 02 add_image
+ */
+#define VERIMARK_ENROLL_KEEPALIVE_PERIOD_MS 500
+
+static gboolean
+verimark_enroll_one_swipe(FpiDeviceVerimark *self,
+                           int swipe_idx,
+                           VerimarkEnrollAddImageResult *out_result,
+                           gboolean *out_timed_out,
+                           GError **out_err)
+{
+    *out_timed_out = FALSE;
+    *out_err = NULL;
+    memset(out_result, 0, sizeof(*out_result));
+
+    VerimarkTransportIoCtx io_ctx;
+    VerimarkTransportIO io;
+    verimark_io_bind(self, &io_ctx, &io);
+    uint16_t st = 0;
+
+    /* Drain the queue from the previous swipe / from BEGIN.
+     * Cursors : cursor_a = 2 + 3 * (idx - 1), cursor_b = cursor_a + 1. */
+    uint16_t cursor_a = (uint16_t)(2 + 3 * (swipe_idx - 1));
+    uint16_t cursor_b = (uint16_t)(cursor_a + 1);
+    verimark_enroll_drain_pre_cycle(self, &io, cursor_a, cursor_b);
+
+    /* WARM first — loosen the on-chip pre-filter so marginal poses
+     * get accepted. Without this the firmware drops the swipe silently. */
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_WARM, &st);
+
+    /* 0x39 ENROLL_D for the FIRST swipe (init) ; RICH for subsequent
+     * swipes. Both turn the white LED on. */
+    const uint8_t *cfg = (swipe_idx == 1) ? VERIMARK_CFG_ENROLL_D
+                                          : VERIMARK_CFG_RICH;
+    verimark_capture_config(&self->session, &io, cfg, &st);
+
+    verimark_capture_event_config(&self->session, &io,
+                                   VERIMARK_MASK_FRAME_READY_ARM,
+                                   VERIMARK_MASK_FRAME_READY_ARM, 0, &st);
+
+    fp_info("enroll: swipe %d — PLACE FINGER ON SENSOR (timeout %d s, WARM mode)",
+            swipe_idx, VERIMARK_ENROLL_SWIPE_TIMEOUT_S);
+    g_print(">>> SWIPE %d — vary finger position slightly between swipes <<<\n",
+            swipe_idx);
+
+    if (!verimark_capture_start(&self->session, &io,
+                                 VERIMARK_CAPSTART_ENROLL, &st)) {
+        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                               "enroll: 0x80 capture_start failure");
+        return FALSE;
+    }
+
+    /* Poll for FRAME_READY OR (WARM-mode) any type=0x18 event, while
+     * interleaving a 0x39 RICH↔SPARSE keep-alive every 500 ms — without
+     * it the firmware disarms the FSM and the LED goes out. */
+    gint64 deadline_us = g_get_monotonic_time()
+                       + (gint64)VERIMARK_ENROLL_SWIPE_TIMEOUT_S * G_USEC_PER_SEC;
+    gint64 next_keepalive_us = g_get_monotonic_time()
+                       + (gint64)VERIMARK_ENROLL_KEEPALIVE_PERIOD_MS * 1000;
+    gboolean frame_ready = FALSE;
+    gboolean led_is_on = TRUE;
+    int poll_count = 0;
+
+    while (g_get_monotonic_time() < deadline_us) {
+        gint64 now = g_get_monotonic_time();
+        if (now >= next_keepalive_us) {
+            const uint8_t *cfg_alt = led_is_on ? VERIMARK_CFG_SPARSE
+                                               : VERIMARK_CFG_RICH;
+            verimark_capture_config(&self->session, &io, cfg_alt, &st);
+            led_is_on = !led_is_on;
+            next_keepalive_us = now
+                + (gint64)VERIMARK_ENROLL_KEEPALIVE_PERIOD_MS * 1000;
+        }
+        poll_count++;
+        VerimarkEventReadResult r = {0};
+        uint16_t poll_st = 0;
+        if (verimark_capture_event_read(&self->session, &io, 0, 32, &r,
+                                         &poll_st))
+        {
+            if (verimark_capture_events_have_frame_ready(&r, NULL)) {
+                fp_dbg("enroll: FRAME_READY after %d poll(s)", poll_count);
+                frame_ready = TRUE;
+            }
+            for (size_t i = 0; i < r.returned_count && !frame_ready; i++) {
+                if (r.events[i].type == 0x18) {
+                    fp_dbg("enroll: WARM_FRAME (type=0x18 val0=0x%08x) "
+                           "after %d poll(s)",
+                           (unsigned)r.events[i].val0, poll_count);
+                    frame_ready = TRUE;
+                }
+            }
+            if (frame_ready)
+                break;
+        }
+        g_usleep(VERIMARK_VERIFY_POLL_INTERVAL_MS * 1000);
+    }
+
+    /* Close the capture window. */
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_SPARSE, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   NULL, NULL, 4, &st);
+    verimark_capture_status_poll(&self->session, &io, &st, &st);
+
+    if (!frame_ready) {
+        *out_timed_out = TRUE;
+        return FALSE;
+    }
+
+    /* 0x96 02 add_image — sensor evaluates the captured swipe. */
+    uint16_t ai_st = 0;
+    if (!verimark_enroll_add_image(&self->session, &io, out_result, &ai_st)) {
+        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                               "enroll: 0x96 02 add_image transport failure");
+        return FALSE;
+    }
+    if (ai_st != 0x0000) {
+        *out_err = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                               "enroll: 0x96 02 sensor status 0x%04x", ai_st);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+
+/**
+ * Run the 12-opcode PRELUDE that primes the enroll FSM. Side-effects
+ * only ; transport / status errors are logged but not fatal.
+ */
+static void
+verimark_enroll_prelude(FpiDeviceVerimark *self)
+{
+    VerimarkTransportIoCtx io_ctx;
+    VerimarkTransportIO io;
+    verimark_io_bind(self, &io_ctx, &io);
+    uint16_t st = 0;
+    VerimarkEventReadResult ev = {0};
+
+    /* Steps 1..3 — drain queue + arm subscribe-all. */
+    verimark_capture_event_config(&self->session, &io,
+                                   VERIMARK_MASK_EVENTS_1_AND_2,
+                                   VERIMARK_MASK_EVENTS_1_AND_2, 0, &st);
+    verimark_capture_event_read(&self->session, &io, 0, 32, &ev, &st);
+    verimark_capture_event_config(&self->session, &io, NULL, NULL, 4, &st);
+
+    /* Steps 4..10 — one verify-style capture cycle (no finger expected). */
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_RICH, &st);
+    verimark_capture_event_config(&self->session, &io,
+                                   VERIMARK_MASK_FRAME_READY_ARM,
+                                   VERIMARK_MASK_FRAME_READY_ARM, 0, &st);
+    verimark_capture_start(&self->session, &io, VERIMARK_CAPSTART_VERIFY, &st);
+    verimark_capture_event_read(&self->session, &io, 0, 32, &ev, &st);
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_SPARSE, &st);
+    verimark_capture_event_config(&self->session, &io, NULL, NULL, 4, &st);
+    verimark_capture_status_poll(&self->session, &io, &st, &st);
+
+    /* Step 11 — 0x99 verify probe (response ignored, side-effect priming). */
+    VerimarkMatchVerdict v = {0};
+    verimark_match_simple(&self->session, &io, &v, &st);
+
+    /* Step 12 — 0x39 ENROLL_E mode-switch. */
+    verimark_capture_config(&self->session, &io, VERIMARK_CFG_ENROLL_E, &st);
+
+    fp_dbg("enroll: PRELUDE complete");
 }
 
 
