+/**
+ * Search a libfprint identify gallery for the first FpPrint whose
+ * opaque tuid (= class-1 storage_handle) equals `needle`. Returns
+ * the print (borrowed reference, owned by the gallery), or NULL.
+ */
+static FpPrint *
+verimark_gallery_find_by_tuid(GPtrArray *gallery,
+                              const uint8_t needle[VERIMARK_STORAGE_TUID_LEN])
+{
+    if (!gallery || !needle)
+        return NULL;
+    for (guint i = 0; i < gallery->len; i++) {
+        FpPrint *p = (FpPrint *)g_ptr_array_index(gallery, i);
+        g_autoptr(GVariant) tid_var = NULL;
+        const uint8_t *tuid = NULL;
+        if (!verimark_extract_tuid_from_print(p, &tid_var, &tuid))
+            continue;
+        if (memcmp(tuid, needle, VERIMARK_STORAGE_TUID_LEN) == 0)
+            return p;
+    }
+    return NULL;
 }
 
 
