+            /* Surface the rejection to fprintd's UI via a retry-class
+             * GError. fpi_device_enroll_progress consumes the error
+             * (steals the reference), so use a plain pointer. */
+            GError *retry_err = g_error_new(
+                FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL,
+                "swipe rejected — vary finger position");
+            fpi_device_enroll_progress(device, useful_swipes, NULL, retry_err);
+        }
+    }
+
+    /* === Commit gate === */
+    if (bitmask != VERIMARK_ENROLL_TARGET_BITMASK_7F) {
+        verimark_enroll_finish(&self->session, &io, &st);
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "enroll: template incomplete after %d attempts "
+                            "(final bitmask 0x%02x, target 0x7f)",
+                            VERIMARK_ENROLL_MAX_SWIPES, bitmask);
+        fpi_device_enroll_complete(device, NULL, error);
+        return;
+    }
+
+    /* === 0x96 03 commit === */
+    fp_info("enroll: committing template");
+    uint16_t commit_st = 0;
+    if (!verimark_enroll_commit(&self->session, &io, new_tuid,
+                                 NULL /* SID = zeros */, &commit_st)) {
+        verimark_enroll_finish(&self->session, &io, &st);
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "enroll: 0x96 03 commit transport failure");
+        fpi_device_enroll_complete(device, NULL, error);
+        return;
+    }
+    if (commit_st != 0x0000) {
+        verimark_enroll_finish(&self->session, &io, &st);
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "enroll: 0x96 03 commit refused (status 0x%04x)",
+                            commit_st);
+        fpi_device_enroll_complete(device, NULL, error);
+        return;
+    }
+
+    /* === 0x9e 01 DB refresh (informational ; status not enforced) === */
+    VerimarkStorageDbInfo dbi = {0};
+    verimark_storage_get_db_info(&self->session, &io, 0x01, &dbi, &st);
+    fp_info("enroll: DB after commit — class_1=%u class_2=%u class_3=%u",
+            dbi.count_class_1, dbi.count_class_2, dbi.count_class_3);
+
+    /* === 0x96 04 finish === */
+    verimark_enroll_finish(&self->session, &io, &st);
+    fp_info("enroll: FINISH 0x96 04 status=0x%04x", st);
+
+    /* === Attach the tuid to the user-supplied template and report success ===
+     * The libfprint convention (cf. goodixmoc) is to mutate the
+     * caller-supplied template, not allocate a new FpPrint. */
+    FpPrint *template = NULL;
+    fpi_device_get_enroll_data(device, &template);
+    if (template != NULL) {
+        GVariant *tid = g_variant_new_fixed_array(G_VARIANT_TYPE_BYTE,
+                                                   new_tuid,
+                                                   VERIMARK_STORAGE_TUID_LEN,
+                                                   1);
+        GVariant *data = g_variant_new("(@ay)", tid);
+        fpi_print_set_type(template, FPI_PRINT_RAW);
+        fpi_print_set_device_stored(template, TRUE);
+        g_object_set(template, "fpi-data", data, NULL);
+        fpi_device_enroll_complete(device, g_object_ref(template), NULL);
+    } else {
+        /* Defensive fallback : if libfprint didn't hand us a template
+         * (shouldn't happen on a real enroll() call), synthesize one. */
+        FpPrint *fallback = verimark_print_from_tuid(device, new_tuid);
+        g_object_ref_sink(fallback);
+        fpi_device_enroll_complete(device, fallback, NULL);
+    }
+    fp_info("enroll: complete — new template stored");
+}
