+ * against.
+ */
+static gboolean
+verimark_run_verify_pipeline(FpiDeviceVerimark *self,
+                              gboolean *out_frame_ready,
+                              gboolean *out_match,
+                              uint8_t out_matched_tuid[VERIMARK_STORAGE_TUID_LEN],
