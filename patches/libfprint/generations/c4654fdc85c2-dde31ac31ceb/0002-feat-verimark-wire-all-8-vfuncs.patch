+    if (!g_variant_check_format_string(data, "(@ay)", FALSE))
+        return FALSE;
+
+    GVariant *tid_var = NULL;
+    g_variant_get(data, "(@ay)", &tid_var);
+    gsize tid_len = 0;
+    const guint8 *tid = g_variant_get_fixed_array(tid_var, &tid_len, 1);
+    if (tid_len != VERIMARK_STORAGE_TUID_LEN) {
+        g_variant_unref(tid_var);
+        return FALSE;
+    }
+    *tid_var_out = tid_var;
+    *tuid_out    = tid;
+    return TRUE;
