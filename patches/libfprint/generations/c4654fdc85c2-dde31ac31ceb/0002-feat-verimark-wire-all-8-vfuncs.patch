+ * `g_ptr_array_add (… , g_object_ref_sink (print))`.
+ */
+static FpPrint *
+verimark_print_from_tuid(FpDevice *device,
+                         const uint8_t tuid[VERIMARK_STORAGE_TUID_LEN])
+{
