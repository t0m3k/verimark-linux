diff --git a/libfprint/drivers/verimark/transport.h b/libfprint/drivers/verimark/transport.h
index b54f691..a56b9f0 100644
--- a/libfprint/drivers/verimark/transport.h
+++ b/libfprint/drivers/verimark/transport.h
@@ -83,6 +83,56 @@ VerimarkResult verimark_ctrl_in(VerimarkUsbHandle *h,
                                 unsigned timeout_ms);
 
 
+/* --- BULK primitives (IT, 047d:8054) ------------------------------------ */
+/*
+ * The IT speaks the Tudor protocol over BULK endpoints, unlike the DT
+ * which uses vendor control transfers. These primitives mirror the
+ * pyusb-based functions used in tools/verimark-it/handshake_attempt.py,
+ * runtime-validated end-to-end on 2026-06-07 (voie A handshake + AppData
+ * round-trip). See proto.h § "IT-specific BULK transport" for the EP
+ * constants.
+ */
+
+/**
+ * Send `data` to an IT BULK OUT endpoint (typically EP01).
+ *
+ * @param ep          Endpoint number (e.g. VERIMARK_IT_EP_BULK_OUT).
+ * @param data        Buffer to send (must be non-NULL if data_len > 0).
+ * @param data_len    Number of bytes to send.
+ * @param timeout_ms  Timeout in milliseconds.
+ *
+ * @return VERIMARK_OK on full send, an error otherwise.
+ */
+VerimarkResult verimark_bulk_out(VerimarkUsbHandle *h,
+                                 uint8_t ep,
+                                 const uint8_t *data,
+                                 size_t data_len,
+                                 unsigned timeout_ms);
+
+/**
+ * Read up to `data_size` bytes from an IT BULK IN endpoint (typically EP81).
+ * Returns immediately on the first short packet (< 64 bytes) — mirrors the
+ * Python `bulk_read_all` loop. The caller passes a buffer large enough for
+ * the maximum expected response (e.g. 802 bytes for a pair response, or
+ * 4096 for an AppData record).
+ *
+ * @param ep          Endpoint number.
+ * @param data        Receive buffer (caller-allocated).
+ * @param data_size   Buffer capacity (also the per-chunk read size).
+ * @param[out] received   Total bytes actually received.
+ * @param timeout_ms  Total timeout in milliseconds.
+ *
+ * @return VERIMARK_OK if at least one chunk was read, VERIMARK_ERR_TIMEOUT
+ *         if no bytes arrived within the total timeout.
+ */
+VerimarkResult verimark_bulk_in(VerimarkUsbHandle *h,
+                                uint8_t ep,
+                                uint8_t *data,
+                                size_t data_size,
+                                size_t *received,
+                                unsigned timeout_ms);
+
+
 /* --- High-level helpers --------------------------------------------------- */
 
 /**
