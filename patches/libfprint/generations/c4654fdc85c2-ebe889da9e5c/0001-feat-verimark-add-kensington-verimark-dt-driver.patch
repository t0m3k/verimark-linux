+static void verimark_list(FpDevice *device)
+{
+    /*
+     * libfprint `list()` returns the prints currently enrolled on the
+     * sensor. Reading the actual template data requires reading the host
+     * partition (opcode 0x40), which lives inside the encrypted TLS
+     * session. Until the TLS handshake is solved (see
+     * ../../docs/phase5-tls-psk-linux.md), we can still **locate** the
+     * host partition via the cleartext opcode 0x3E (get_storage_info)
+     * and return an explicit error pointing at the missing piece.
+     *
+     * This stub at least validates the storage_info parser on the wire
+     * and gives fprintd a more informative failure than NOT_SUPPORTED.
+     */
+    G_DEBUG_HERE();
+    FpiDeviceVerimark *self = FPI_DEVICE_VERIMARK(device);
+    g_autoptr(GError) error = NULL;
+
+    uint8_t resp_buf[256];
+    const uint8_t *payload = NULL;
+    size_t payload_len = 0;
+    uint16_t status = 0;
+    gboolean ok = send_simple_opcode(self, VERIMARK_OP_GET_STORAGE_INFO,
+                                     resp_buf, sizeof(resp_buf),
+                                     &payload, &payload_len, &status, &error);
+    if (!ok) {
+        fpi_device_list_complete(device, NULL, error);
+        return;
+    }
+
+    VerimarkStorageInfo info;
+    if (!verimark_parse_storage_info(payload, payload_len, &info)) {
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "list: storage_info parse failed "
+                            "(payload %zu bytes)", payload_len);
+        fpi_device_list_complete(device, NULL, error);
+        return;
+    }
+
+    const VerimarkStorageEntry *host =
+        verimark_storage_find_host_partition(&info);
+    if (host == NULL) {
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                            "list: no host partition (type=0x02) in "
+                            "storage_info (%u entries)", info.entry_count);
+        fpi_device_list_complete(device, NULL, error);
+        return;
+    }
+
+    fp_dbg("list: host partition located (b_1=0x%02x field_2=0x%04x "
+           "field_4=0x%08x field_8=0x%08x), but template enumeration "
+           "requires TLS session",
+           host->b_1, host->field_2, host->field_4, host->field_8);
+
+    error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED,
+                        "list: host partition located (%u storage entries), "
+                        "but reading enrolled templates requires the TLS-PSK "
+                        "session (Phase 5 blocker)", info.entry_count);
+    fpi_device_list_complete(device, NULL, error);
+}
+
+
+static void verimark_delete(FpDevice *device)
+{
+    g_autoptr(GError) error = g_error_new(FP_DEVICE_ERROR,
+                                          FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                          "delete: requires partition-write API (TLS handshake required)");
+    fpi_device_delete_complete(device, error);
+}
