+    dev_class->id        = "verimark";
+    dev_class->full_name = "Kensington VeriMark DT";
+    dev_class->type      = FP_DEVICE_TYPE_USB;
+    dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+    dev_class->id_table  = id_table;
+    dev_class->nr_enroll_stages = 8;
+    dev_class->features  = FP_DEVICE_FEATURE_CAPTURE
+                         | FP_DEVICE_FEATURE_IDENTIFY
+                         | FP_DEVICE_FEATURE_VERIFY
+                         | FP_DEVICE_FEATURE_STORAGE
+                         | FP_DEVICE_FEATURE_STORAGE_LIST
+                         | FP_DEVICE_FEATURE_STORAGE_DELETE
+                         | FP_DEVICE_FEATURE_DUPLICATES_CHECK;
+
+    dev_class->probe    = verimark_probe;
+    dev_class->open     = verimark_open;
+    dev_class->close    = verimark_close;
+    dev_class->verify   = verimark_verify;
+    dev_class->enroll   = verimark_enroll;
+    dev_class->identify = verimark_identify;
+    dev_class->list     = verimark_list;
+    dev_class->delete   = verimark_delete;
+}
