-        };
-        io.write(io.ctx, plain_close_notify,
-                 sizeof(plain_close_notify), /*is_handshake=*/true);
-        uint8_t drain[64];
-        size_t drain_len = 0;
-        io.read(io.ctx, drain, sizeof(drain), &drain_len);
-        verimark_session_zero(&self->session);
