+    RUN(build_client_hello_it_byte_by_byte);
+    RUN(build_client_hello_it_buffer_too_small);
+    RUN(build_client_hello_it_diff_with_dt);
     RUN(build_certificate_body_then_wrap);
     RUN(build_cke_body_then_wrap);
     RUN(build_cv_body_then_wrap);
