diff --git a/libfprint/drivers/verimark/tls.h b/libfprint/drivers/verimark/tls.h
index 796db77..8692bc0 100644
--- a/libfprint/drivers/verimark/tls.h
+++ b/libfprint/drivers/verimark/tls.h
@@ -94,6 +94,25 @@ size_t verimark_tls_build_client_hello(const uint8_t random_32[32],
                                        uint8_t *out, size_t out_size);
 
 
+/* Build the IT-specific ClientHello (78 octets) — same structure as the DT
+ * builder above, but with **5 ciphers** instead of 6 (cipher 0x00a9 is
+ * removed). The IT firmware rejects ClientHellos containing 0x00a9 with
+ * a fatal illegal_parameter Alert ; the exact 5-cipher set is verbatim
+ * from the documented device trace. Layout differences from the DT builder :
+ *   record length    0x0049 (= 73)  vs DT 0x004b (= 75)
+ *   HS length        0x0045 (= 69)  vs DT 0x0047 (= 71)
+ *   cs_len           0x000a         vs DT 0x000c
+ *   cipher suites    c005 c02e 003d 008d 00a8  (no 00a9)
+ *
+ * Returns 78 on success, 0 on buffer too small.
+ *
+ * The caller is responsible for prepending the 4-byte transport prefix
+ * (VERIMARK_IT_HS_PREFIX) before writing to BULK EP01 OUT.
+ */
+size_t verimark_tls_build_client_hello_it(const uint8_t random_32[32],
+                                          uint8_t *out, size_t out_size);
+
+
 /* Build the Certificate body (NOT the full HS message) :
  *   `[chain_len 3 BE = 400][cert#0_len 3 BE = 400][magic 0d d0][cert_400]`
  *
