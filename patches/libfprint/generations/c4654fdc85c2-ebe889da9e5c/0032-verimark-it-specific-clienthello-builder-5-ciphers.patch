 4 files changed, 122 insertions(+)

diff --git a/libfprint/drivers/verimark/tests/test_tls.c b/libfprint/drivers/verimark/tests/test_tls.c
index 64bf67e..7d20cf1 100644
--- a/libfprint/drivers/verimark/tests/test_tls.c
+++ b/libfprint/drivers/verimark/tests/test_tls.c
@@ -139,6 +139,52 @@ TEST(build_client_hello_buffer_too_small)
     return 0;
 }
 
+TEST(build_client_hello_it_byte_by_byte)
+{
+    uint8_t out[128];
+    size_t n = verimark_tls_build_client_hello_it(TV_HS_FIXED_CLIENT_RANDOM,
+                                                  out, sizeof(out));
+    ASSERT_EQ(n, TV_HS_CLIENT_HELLO_IT_RECORD_LEN);
+    ASSERT_MEM_EQ(out, TV_HS_CLIENT_HELLO_IT_RECORD, n);
+    return 0;
+}
+
+TEST(build_client_hello_it_buffer_too_small)
+{
+    uint8_t out[40];
+    size_t n = verimark_tls_build_client_hello_it(TV_HS_FIXED_CLIENT_RANDOM,
+                                                  out, sizeof(out));
+    ASSERT_EQ(n, 0);
+    return 0;
+}
+
+TEST(build_client_hello_it_diff_with_dt)
+{
+    /* The IT and DT records differ only in cs_len (1 byte) + the
+     * presence of cipher 0x00a9 (2 bytes) — total 78 vs 80 bytes. */
+    uint8_t dt[128], it[128];
+    size_t dn = verimark_tls_build_client_hello(TV_HS_FIXED_CLIENT_RANDOM,
+                                                 dt, sizeof(dt));
+    size_t in = verimark_tls_build_client_hello_it(TV_HS_FIXED_CLIENT_RANDOM,
+                                                    it, sizeof(it));
+    ASSERT_EQ(dn, 80);
+    ASSERT_EQ(in, 78);
+    /* Bytes 0..52 are identical except for the length fields at
+     * offsets 3-4 (record), 7-8 (HS) — both shrink by 2 in IT. */
+    /* Verify the IT record does NOT contain the bytes 00 a9 at the
+     * cipher suites offset (offset 53..62 are 5 ciphers = 10 bytes). */
+    /* cipher_suites start at offset 53 (after 5-byte record hdr + 4-byte HS
+     * hdr + 2-byte version + 32-byte random + 1+7 sid + 2-byte cs_len). */
+    static const uint8_t expected_it_ciphers[10] = {
+        0xc0, 0x05, 0xc0, 0x2e, 0x00, 0x3d, 0x00, 0x8d, 0x00, 0xa8,
+    };
+    ASSERT_MEM_EQ(it + 53, expected_it_ciphers, 10);
+    /* The byte immediately after must NOT be 0xa9 (the dropped cipher)
+     * — it must be the comp_meth_len = 0x00. */
+    ASSERT_EQ(it[63], 0x00);
+    return 0;
+}
+
 
 /* ---- Certificate body builder + wrap as HS msg --------------------------- */
 
@@ -303,6 +349,9 @@ int main(void)
     RUN(parse_record_body_truncated);
