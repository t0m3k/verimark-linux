+/* IT variant of the ClientHello (78 octets) — same shape with 5 ciphers
+ * (no 0x00a9) instead of 6. Lengths in the record/HS/cs headers shrink
+ * by 2 bytes. Verbatim from the documented device trace structure with the
+ * fixed test random for reproducibility. */
+static const uint8_t TV_HS_CLIENT_HELLO_IT_RECORD[78] = {
+    0x16, 0x03, 0x03, 0x00, 0x49, 0x01, 0x00, 0x00, 0x45, 0x03, 0x03, 0xeb, 0xfb, 0x32, 0x2e, 0x0d,
+    0xd0, 0x6e, 0xbe, 0x9f, 0x93, 0x22, 0xc1, 0xb8, 0xc6, 0x51, 0x8d, 0x87, 0x50, 0x6a, 0xed, 0xd5,
+    0x1b, 0x83, 0x27, 0xfd, 0xf5, 0xb0, 0xd3, 0x71, 0xd6, 0xb7, 0x12, 0x07, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x0a, 0xc0, 0x05, 0xc0, 0x2e, 0x00, 0x3d, 0x00, 0x8d, 0x00, 0xa8, 0x00,
+    0x00, 0x0a, 0x00, 0x04, 0x00, 0x02, 0x00, 0x17, 0x00, 0x0b, 0x00, 0x02, 0x01, 0x00,
+};
+static const size_t TV_HS_CLIENT_HELLO_IT_RECORD_LEN = 78;
 /* Certificate HS msg : type 0x0b + len 3 + body (chain_len + cert_len + magic 0d d0 + cert) */
 static const uint8_t TV_HS_CERTIFICATE_MSG[412] = {
     0x0b, 0x00, 0x01, 0x98, 0x00, 0x01, 0x90, 0x00, 0x01, 0x90, 0x0d, 0xd0, 0xa5, 0xa2, 0xab, 0xb0,
diff --git a/libfprint/drivers/verimark/tls.c b/libfprint/drivers/verimark/tls.c
index f28dc9d..86f1ead 100644
--- a/libfprint/drivers/verimark/tls.c
+++ b/libfprint/drivers/verimark/tls.c
@@ -132,6 +132,48 @@ size_t verimark_tls_build_client_hello(const uint8_t random_32[32],
 }
 
 
+size_t verimark_tls_build_client_hello_it(const uint8_t random_32[32],
+                                          uint8_t *out, size_t out_size)
+{
+    /* IT-specific ClientHello layout :
+     *   [5]   TLS record hdr  : 16 03 03 00 49   (len = 73)
+     *   [4]   HS hdr          : 01 00 00 45      (ClientHello, len 69)
+     *   [2]   version         : 03 03
+     *   [32]  random
+     *   [1]   session_id_len  : 07
+     *   [7]   session_id      : 00 × 7
+     *   [2]   cs_len          : 00 0a
+     *   [10]  cipher_suites   : c0 05 c0 2e 00 3d 00 8d 00 a8   (no 00 a9)
+     *   [1]   comp_meth_len   : 00
+     *   [2]   ext_list_len    : 00 0a
+     *   [6]   ext supported_groups : 00 04 00 02 00 17
+     *   [6]   ext ec_point_formats : 00 0b 00 02 01 00
+     */
+    if (!out || !random_32) return 0;
+    if (out_size < 78) return 0;
+    static const uint8_t head[] = {
+        0x16, 0x03, 0x03, 0x00, 0x49,            /* record hdr */
+        0x01, 0x00, 0x00, 0x45,                  /* HS hdr */
+        0x03, 0x03,                               /* version */
+    };
+    static const uint8_t tail[] = {
+        0x07,                                                /* sid_len */
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,            /* sid */
+        0x00, 0x0a,                                          /* cs_len (5 cs) */
+        0xc0, 0x05, 0xc0, 0x2e, 0x00, 0x3d,                   /* cs (5 ciphers, */
+        0x00, 0x8d, 0x00, 0xa8,                               /*  no 00 a9)     */
+        0x00,                                                /* comp_meth_len */
+        0x00, 0x0a,                                          /* ext_list_len */
+        0x00, 0x04, 0x00, 0x02, 0x00, 0x17,                   /* ext supported_groups */
+        0x00, 0x0b, 0x00, 0x02, 0x01, 0x00,                   /* ext ec_point_formats */
+    };
+    memcpy(out, head, sizeof(head));
+    memcpy(out + sizeof(head), random_32, 32);
+    memcpy(out + sizeof(head) + 32, tail, sizeof(tail));
+    return 78;
+}
+
+
