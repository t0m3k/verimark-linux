@@ -210,6 +210,40 @@ TEST(first_write_is_expected_client_hello)
 }
 
 
+TEST(first_write_is_expected_client_hello_it_variant)
+{
+    /* When is_it_variant=true the orchestrator must emit the 78-byte
+     * IT ClientHello (5 ciphers, no 0x00a9) rather than the 80-byte DT
+     * one. The 44 00 00 00 prefix handling is unchanged. */
+    VerimarkPairingData pairing;
+    load_synthetic_pairing(&pairing);
+
+    VerimarkHandshakeReproducibleParams repro;
+    memcpy(repro.client_random, TV_HS_FIXED_CLIENT_RANDOM, 32);
+    memset(repro.eph_priv_be, 0x42, 32);
+
+    static const uint8_t alert_record[] = {
+        0x15, 0x03, 0x03, 0x00, 0x02, 0x02, 0x28
+    };
+    MockTransport m = {0};
+    m.next_response = alert_record;
+    m.next_response_len = sizeof(alert_record);
+    VerimarkTransportIO io = { mock_write, mock_read, &m };
+
+    VerimarkSession s;
+    VerimarkHandshakeResult r = verimark_handshake_perform(&io, &pairing, &repro,
+                                                            /*is_it_variant*/ true,
+                                                            &s);
+    ASSERT_EQ(r, VERIMARK_HANDSHAKE_ERR_SERVER_ALERT);
+
+    ASSERT_EQ(m.last_write_len, TV_HS_CLIENT_HELLO_IT_RECORD_LEN);
+    ASSERT_MEM_EQ(m.last_write, TV_HS_CLIENT_HELLO_IT_RECORD, m.last_write_len);
+    ASSERT_TRUE(m.last_write_is_handshake);
+    ASSERT_EQ(m.write_count, 1);
+    return 0;
+}
+
+
 /* ---- main --------------------------------------------------------------- */
 
 #define RUN(name) do { \
@@ -229,6 +263,7 @@ int main(void)
     RUN(read_fail_returns_err_read);
     RUN(server_alert_returns_err_server_alert);
     RUN(first_write_is_expected_client_hello);
+    RUN(first_write_is_expected_client_hello_it_variant);
 
     fprintf(stderr, "\n%d passed, %d failed\n", passed, failed);
     return failed == 0 ? 0 : 1;
