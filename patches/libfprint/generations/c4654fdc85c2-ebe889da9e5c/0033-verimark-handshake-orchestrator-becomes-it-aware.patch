     VerimarkSession s;
-    VerimarkHandshakeResult r = verimark_handshake_perform(&io, &pairing, &repro, &s);
+    VerimarkHandshakeResult r = verimark_handshake_perform(&io, &pairing, &repro, false, &s);
     /* We expect a server_alert (we sent CH then read a fake alert) */
