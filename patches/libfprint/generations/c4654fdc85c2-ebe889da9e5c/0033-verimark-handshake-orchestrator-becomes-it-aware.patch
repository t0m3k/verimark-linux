diff --git a/libfprint/drivers/verimark/handshake.c b/libfprint/drivers/verimark/handshake.c
index e99f43f..cd591fa 100644
--- a/libfprint/drivers/verimark/handshake.c
+++ b/libfprint/drivers/verimark/handshake.c
@@ -85,6 +85,7 @@ VerimarkHandshakeResult
 verimark_handshake_perform(VerimarkTransportIO *io,
                             const VerimarkPairingData *pairing,
                             const VerimarkHandshakeReproducibleParams *repro_or_null,
+                            bool is_it_variant,
                             VerimarkSession *session_out)
 {
     if (!io || !io->write || !io->read || !pairing || !session_out)
@@ -112,9 +113,12 @@ verimark_handshake_perform(VerimarkTransportIO *io,
         }
     }
 
-    /* ---- 2. ClientHello ---- */
-    size_t ch_n = verimark_tls_build_client_hello(client_random,
-                                                   b->ch_record, sizeof(b->ch_record));
+    /* ---- 2. ClientHello (DT 80 B / 6 ciphers, IT 78 B / 5 ciphers) ---- */
+    size_t ch_n = is_it_variant
+        ? verimark_tls_build_client_hello_it(client_random,
+                                              b->ch_record, sizeof(b->ch_record))
+        : verimark_tls_build_client_hello(client_random,
+                                           b->ch_record, sizeof(b->ch_record));
     if (ch_n == 0) { result = VERIMARK_HANDSHAKE_ERR_CRYPTO; goto out; }
     if (!io->write(io->ctx, b->ch_record, ch_n, /*is_handshake*/ true)) {
         result = VERIMARK_HANDSHAKE_ERR_WRITE;
@@ -480,6 +484,7 @@ typedef struct {
     VerimarkPairingData pairing;             /* SECRET — wiped on free */
     bool               has_repro;
     VerimarkHandshakeReproducibleParams repro;
+    bool               is_it_variant;        /* 5-cipher ClientHello (IT) */
     GCancellable      *cancellable;          /* not owned */
 
     /* --- Working buffers : same layout as sync HandshakeBufs. --- */
@@ -555,7 +560,10 @@ handshake_async_build_client_hello(HandshakeAsyncCtx *ctx)
             return VERIMARK_HANDSHAKE_ERR_CRYPTO;
     }
 
-    size_t ch_n = verimark_tls_build_client_hello(ctx->client_random,
+    size_t ch_n = ctx->is_it_variant
+        ? verimark_tls_build_client_hello_it(ctx->client_random,
+                                              b->ch_record, sizeof(b->ch_record))
+        : verimark_tls_build_client_hello(ctx->client_random,
                                                    b->ch_record,
                                                    sizeof(b->ch_record));
     if (ch_n == 0)
@@ -916,6 +924,7 @@ verimark_handshake_perform_async(
     unsigned timeout_ms,
     const VerimarkPairingData *pairing,
     const VerimarkHandshakeReproducibleParams *repro_or_null,
+    bool is_it_variant,
     GCancellable *cancellable,
     GAsyncReadyCallback callback,
     gpointer user_data)
@@ -937,6 +946,7 @@ verimark_handshake_perform_async(
     ctx->has_repro   = (repro_or_null != NULL);
     if (ctx->has_repro)
         ctx->repro = *repro_or_null;
+    ctx->is_it_variant = is_it_variant;
     ctx->cancellable = cancellable;
     ctx->bufs = (HandshakeBufs *)calloc(1, sizeof(HandshakeBufs));
     if (ctx->bufs == NULL) {
diff --git a/libfprint/drivers/verimark/handshake.h b/libfprint/drivers/verimark/handshake.h
index 01f2cb5..80c2c1a 100644
--- a/libfprint/drivers/verimark/handshake.h
+++ b/libfprint/drivers/verimark/handshake.h
@@ -100,11 +100,15 @@ typedef struct {
