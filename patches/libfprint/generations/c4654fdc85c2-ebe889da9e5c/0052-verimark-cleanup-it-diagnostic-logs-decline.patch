-            "payload_len %zu", ctx->attempt, status, payload_len);
     if (status == 0x0000 && payload && payload_len >= VERIMARK_STORAGE_TUID_LEN) {
         ctx->matched = TRUE;
         memcpy(ctx->matched_tuid, payload, VERIMARK_STORAGE_TUID_LEN);
-        /* TEMP fp_warn (diagnose) — comparing matched_tuid against the
-         * enrolled TUID will tell whether the IT firmware is using a
