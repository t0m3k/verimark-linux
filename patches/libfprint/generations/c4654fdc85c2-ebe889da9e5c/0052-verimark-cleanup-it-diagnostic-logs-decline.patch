             cancel, vfy_cb_match, ssm);
@@ -2608,8 +2584,8 @@ enroll_sm_run_state(FpiSsm *ssm, FpDevice *dev)
                 fpi_ssm_jump_to_state(ssm, ENR_S_CLEANUP_FINISH);
