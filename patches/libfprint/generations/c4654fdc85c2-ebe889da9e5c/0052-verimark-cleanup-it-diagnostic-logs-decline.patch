-        fp_warn("verify: attempt %d no-match (status 0x%04x, %zu bytes, "
-                "first 8 = %02x %02x %02x %02x %02x %02x %02x %02x)",
+        fp_dbg("verify: attempt %d no-match (status 0x%04x, %zu bytes, "
+               "first 8 = %02x %02x %02x %02x %02x %02x %02x %02x)",
                 ctx->attempt, status, payload_len,
                 payload && payload_len >= 1 ? payload[0] : 0,
                 payload && payload_len >= 2 ? payload[1] : 0,
@@ -1459,8 +1437,8 @@ verify_sm_run_state(FpiSsm *ssm, FpDevice *dev)
 
     /* ===== After-poll dispatch ========================================= */
     case VFY_S_AFTER_POLL:
-        fp_warn("verify: AFTER_POLL attempt=%d frame_ready=%d polls=%d "
-                "false_detect=%d",
+        fp_dbg("verify: AFTER_POLL attempt=%d frame_ready=%d polls=%d "
