             verimark_session_call_opcode_async(&self->session, self->transport,
                 3000, 0x96, it_commit_payload, n,
                 cancel, enr_cb_commit, ssm);
@@ -2664,17 +2640,10 @@ enroll_sm_run_state(FpiSsm *ssm, FpDevice *dev)
                 break;
             }
         }
-        /* TEMP diag : confirm the template was actually persisted on the
-         * sensor by checking that getlist post-enroll grew vs pre-enroll. */
-        fp_warn("enroll: RESOLVE_TUID — pre_count=%u post_count=%u found_new=%d, "
-                "effective_tuid[0..8] = %02x %02x %02x %02x %02x %02x %02x %02x",
-                (unsigned)ctx->pre_list.count,
-                (unsigned)ctx->post_list.count,
-                (int)found_new,
-                ctx->effective_tuid[0], ctx->effective_tuid[1],
-                ctx->effective_tuid[2], ctx->effective_tuid[3],
-                ctx->effective_tuid[4], ctx->effective_tuid[5],
-                ctx->effective_tuid[6], ctx->effective_tuid[7]);
+        fp_dbg("enroll: RESOLVE_TUID — pre_count=%u post_count=%u found_new=%d",
+               (unsigned)ctx->pre_list.count,
+               (unsigned)ctx->post_list.count,
+               (int)found_new);
         fpi_ssm_mark_completed(ssm);
         return;
     }
@@ -3028,6 +2997,25 @@ static void verimark_delete(FpDevice *device)
         return;
     }
 
+    /* The IT uses opcode 0xa4 with a 1-byte "sub-factor selector"
+     * payload (no TUID) — see docs/it-verify-decode.md § "Delete".
+     * Values 0x80 / 0x81 are special (delete-all categories). The
+     * mapping from FpFinger to sub-factor byte hasn't been runtime-
+     * captured yet, and sending a wrong byte risks wiping ALL
+     * templates on the firmware. Until that work is done we just
+     * decline cleanly so the host-side print list stays consistent
+     * (caller can wipe /var/lib/fprint/<user> manually to reset). */
+    GUsbDevice *usb = fpi_device_get_usb_device(device);
+    if (usb != NULL && g_usb_device_get_pid(usb) == VERIMARK_PID_IT) {
+        error = g_error_new(FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED,
+                            "delete: IT sensor uses opcode 0xa4 with a "
+                            "sub-factor selector that hasn't been decoded "
+                            "yet — to remove the host-side print, delete "
+                            "/var/lib/fprint/<user>/ then re-enroll");
+        fpi_device_delete_complete(device, error);
+        return;
+    }
+
