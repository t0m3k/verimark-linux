+/* --- Sync wrapper around the async `verimark_session_call_opcode_async`.
+ *
+ * Used by the IT branches of synchronous vfuncs (list, delete) that need
+ * to drive AppData over BULK. The verified path for IT AppData is the
+ * async one (cf. verimark_transceive_async → auto-route to BULK by PID,
+ * used by the verify / enroll SSMs which are validated runtime). Raw
+ * `bulk_out`/`bulk_in`/`decrypt_appdata` as the first record after a
+ * fresh handshake reliably GCM-fails (observed 2026-06-07 — 348-byte
+ * body with no valid tag). The async path doesn't exhibit this so we
+ * fund our sync vfuncs through it via a nested GMainContext.
+ *
+ * Nested GMainContext is safe inside an fpi_device vfunc : the outer
+ * libfprint loop is reentrant, and the nested context only services
+ * our one async call. On success, `*payload_out` is a freshly g_malloc'd
+ * buffer (caller must g_free) — same semantics as
+ * `verimark_session_call_opcode_finish`. */
+typedef struct {
+    GMainLoop *loop;
+    gboolean   ok;
+    uint16_t   status;
+    uint8_t   *payload;
+    size_t     payload_len;
+    GError    *err;
+} VerimarkSyncAsyncCtx;
+
+static void
+verimark_call_opcode_sync_cb(GObject *src, GAsyncResult *res, gpointer ud)
+{
+    (void)src;
+    VerimarkSyncAsyncCtx *ctx = ud;
+    GError *err = NULL;
+    ctx->ok = verimark_session_call_opcode_finish(
+        res, &ctx->status, &ctx->payload, &ctx->payload_len, &err);
+    if (err)
+        ctx->err = err;
+    g_main_loop_quit(ctx->loop);
+}
+
+static gboolean
+verimark_call_opcode_sync(FpiDeviceVerimark *self,
+                          uint8_t opcode,
+                          const uint8_t *payload, size_t payload_len,
+                          unsigned timeout_ms,
+                          uint16_t *status_out,
+                          uint8_t **resp_payload_out, size_t *resp_payload_len_out,
+                          GError **error)
+{
+    GMainContext *mctx = g_main_context_new();
+    g_main_context_push_thread_default(mctx);
+    GMainLoop *loop = g_main_loop_new(mctx, FALSE);
+
+    VerimarkSyncAsyncCtx ctx = { .loop = loop };
+    verimark_session_call_opcode_async(
+        &self->session, self->transport, timeout_ms,
+        opcode, payload, payload_len,
+        /*cancellable*/ NULL,
+        verimark_call_opcode_sync_cb, &ctx);
+
+    g_main_loop_run(loop);
+    g_main_loop_unref(loop);
+    g_main_context_pop_thread_default(mctx);
+    g_main_context_unref(mctx);
+
+    if (status_out)         *status_out         = ctx.status;
+    if (resp_payload_out)   *resp_payload_out   = ctx.payload;
+    if (resp_payload_len_out) *resp_payload_len_out = ctx.payload_len;
+    if (!ctx.ok) {
+        if (ctx.err && error) {
+            *error = ctx.err;
+        } else if (ctx.err) {
+            g_error_free(ctx.err);
+        }
+        /* payload was not allocated on failure */
+        return FALSE;
+    }
+    return TRUE;
+}
+
