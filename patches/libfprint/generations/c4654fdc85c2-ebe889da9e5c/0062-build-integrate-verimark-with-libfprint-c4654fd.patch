From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomasz Tracz <t@t90.dev>
Date: Mon, 17 Aug 2026 20:51:46 +0100
Subject: [PATCH 62/62] build: integrate VeriMark with libfprint c4654fd

---
 data/autosuspend.hwdb                  |  8 ++++++--
 libfprint/drivers/verimark/handshake.c |  2 ++
 libfprint/drivers/verimark/verimark.c  |  6 ++----
 libfprint/fprint-list-udev-hwdb.c      |  2 --
 libfprint/meson.build                  | 20 ++++++++++++++++++++
 meson.build                            | 15 +++++++++++++++
 tests/meson.build                      |  2 +-
 7 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/data/autosuspend.hwdb b/data/autosuspend.hwdb
index 5482fc9..7f6255b 100644
--- a/data/autosuspend.hwdb
+++ b/data/autosuspend.hwdb
@@ -352,6 +352,12 @@ usb:v061Ap0110*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
 
+# Supported by libfprint driver verimark
+usb:v047Dp00F2*
+usb:v047Dp8054*
+ ID_AUTOSUSPEND=1
+ ID_PERSIST=0
+
 # Supported by libfprint driver vfs0050
 usb:v138Ap0050*
  ID_AUTOSUSPEND=1
@@ -386,8 +392,6 @@ usb:v138Ap0091*
 usb:v006Bp00DA*
 usb:v0413p2766*
 usb:v045Ep0815*
-usb:v047Dp00F2*
-usb:v047Dp8054*
 usb:v047Dp8055*
 usb:v04E8p730B*
 usb:v04F2pB61E*
diff --git a/libfprint/drivers/verimark/handshake.c b/libfprint/drivers/verimark/handshake.c
index f56b140..139f892 100644
--- a/libfprint/drivers/verimark/handshake.c
+++ b/libfprint/drivers/verimark/handshake.c
@@ -5,7 +5,9 @@
  * caller-provided VerimarkTransportIO vtable.
  */
 
+#ifndef _GNU_SOURCE
 #define _GNU_SOURCE   /* for getrandom on Linux */
+#endif
 
 #include "handshake.h"
 
diff --git a/libfprint/drivers/verimark/verimark.c b/libfprint/drivers/verimark/verimark.c
index 0d4df46..b35e9f8 100644
--- a/libfprint/drivers/verimark/verimark.c
+++ b/libfprint/drivers/verimark/verimark.c
@@ -3417,13 +3417,11 @@ static void fpi_device_verimark_class_init(FpiDeviceVerimarkClass *klass)
     dev_class->id_table  = id_table;
     /* 7 unique-quality swipes are required on-chip (bitmask 0x01..0x7f). */
     dev_class->nr_enroll_stages = VERIMARK_ENROLL_PROGRESS_STAGES;
-    dev_class->features  = FP_DEVICE_FEATURE_CAPTURE
-                         | FP_DEVICE_FEATURE_IDENTIFY
+    dev_class->features  = FP_DEVICE_FEATURE_IDENTIFY
                          | FP_DEVICE_FEATURE_VERIFY
                          | FP_DEVICE_FEATURE_STORAGE
                          | FP_DEVICE_FEATURE_STORAGE_LIST
-                         | FP_DEVICE_FEATURE_STORAGE_DELETE
-                         | FP_DEVICE_FEATURE_DUPLICATES_CHECK;
+                         | FP_DEVICE_FEATURE_STORAGE_DELETE;
 
     dev_class->probe    = verimark_probe;
     dev_class->open     = verimark_open;
diff --git a/libfprint/fprint-list-udev-hwdb.c b/libfprint/fprint-list-udev-hwdb.c
index 539f3e6..e3e2ca4 100644
--- a/libfprint/fprint-list-udev-hwdb.c
+++ b/libfprint/fprint-list-udev-hwdb.c
@@ -33,8 +33,6 @@ static const FpIdEntry allowlist_id_table[] = {
   { .vid = 0x006b, .pid = 0x00da },
   { .vid = 0x0413, .pid = 0x2766 },
   { .vid = 0x045e, .pid = 0x0815 },
-  { .vid = 0x047d, .pid = 0x00f2 },
-  { .vid = 0x047d, .pid = 0x8054 },
   { .vid = 0x047d, .pid = 0x8055 },
   { .vid = 0x0483, .pid = 0x2016 },
   { .vid = 0x04e8, .pid = 0x730b },
diff --git a/libfprint/meson.build b/libfprint/meson.build
index f11533c..67406f1 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -139,6 +139,21 @@ driver_sources = {
     'focaltech_moc' : files('drivers/focaltech_moc/focaltech_moc.c'),
     'mafpmoc' : files('drivers/mafpmoc/mafpmoc.c'),
     'secugen' : files('drivers/secugen.c'),
+    'verimark' : files(
+        'drivers/verimark/verimark.c',
+        'drivers/verimark/proto.c',
+        'drivers/verimark/transport.c',
+        'drivers/verimark/crypto.c',
+        'drivers/verimark/tls.c',
+        'drivers/verimark/pairing.c',
+        'drivers/verimark/session.c',
+        'drivers/verimark/handshake.c',
+        'drivers/verimark/storage.c',
+        'drivers/verimark/capture.c',
+        'drivers/verimark/match.c',
+        'drivers/verimark/enroll.c',
+        'drivers/verimark/bootstrap.c',
+    ),
 }
 
 helper_sources = {
@@ -149,6 +164,7 @@ helper_sources = {
     'pixman': files(),
     'udev': files(),
     'virtual': files('drivers/virtual-device-listener.c'),
+    'tudor_crypto': files(),
 }
 
 drivers_sources = []
@@ -160,6 +176,10 @@ foreach helper : driver_helpers
     drivers_sources += helper_sources[helper]
 endforeach
 
+if 'verimark' in drivers
+    drivers_cflags += [ '-DVERIMARK_HAVE_LIBGUSB=1' ]
+endif
+
 
 fp_enums = gnome.mkenums_simple('fp-enums',
     sources: libfprint_public_headers,
diff --git a/meson.build b/meson.build
index ab09dc1..ad51021 100644
--- a/meson.build
+++ b/meson.build
@@ -147,6 +147,7 @@ drivers_info = {
     'focaltech_moc': {},
     'mafpmoc': {},
     'secugen': {},
+    'verimark': { 'helper': ['tudor_crypto'] },
 
     # SPI driver (non-optional if SPI is available)
     'elanspi': { 'spi': true, 'helper': ['udev'], 'optional': not have_spi },
@@ -254,6 +255,20 @@ foreach i : driver_helpers
         libfprint_conf.set10('HAVE_UDEV', true)
 
         optional_deps += gudev_dep
+    elif i == 'tudor_crypto'
+        gnutls_dep = dependency('gnutls', required: false)
+        nettle_dep = dependency('nettle', required: false)
+        hogweed_dep = dependency('hogweed', required: false)
+        gmp_dep = dependency('gmp', required: false)
+        if not gmp_dep.found()
+            gmp_dep = cc.find_library('gmp', required: false)
+        endif
+        if not (gnutls_dep.found() and nettle_dep.found()
+                and hogweed_dep.found() and gmp_dep.found())
+            error('GnuTLS + nettle + hogweed + gmp are required for @0@'.format(driver))
+        endif
+
+        optional_deps += [gnutls_dep, nettle_dep, hogweed_dep, gmp_dep]
     endif
 endforeach
 
diff --git a/tests/meson.build b/tests/meson.build
index aad0675..16c6be9 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -393,7 +393,7 @@ appstreamcli = find_program('appstreamcli', required: false)
 if appstreamcli.found()
     test('metainfo-validate',
         appstreamcli,
-        args: ['validate', metainfo_generator],
+        args: ['validate', '--no-net', metainfo_generator],
         depends: metainfo_generator,
         suite: ['data', 'no-valgrind'],
     )
